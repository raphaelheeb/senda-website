---
layout: layouts/base.liquid
permalink: /journal/
title: Journal
---
<div class="wrap">
  <header class="page-head">
    <h1 class="h1">Journal</h1>
    <p class="lead">Development notes, engineering and rides. Filter by topic once there are more posts.</p>
  </header>
  <div class="cards" style="padding-bottom: var(--s-6)">
    {% for post in collections.journal %}
    <a class="card" href="{{ post.url }}">
      {% include "partials/frame.liquid", img: post.data.image, ratio: "journal", alt: "" %}
      <p class="label">{{ post.data.topic }}</p>
      <h2 class="h3 mt-1">{{ post.data.title }}</h2>
      <p class="card__sub mt-1">{{ post.data.excerpt }}</p>
    </a>
    {% endfor %}
  </div>
</div>
