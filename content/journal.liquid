---
layout: layouts/base.liquid
permalink: /journal/
title: Journal
---
<div class="wrap">
  <header class="page-head">
    <h1 class="h1">Journal</h1>
    <p class="lead">Testing, decisions and the people who shape SENDA, documented along the way.</p>
  </header>
  <div class="trio" style="padding-bottom: var(--section); row-gap: var(--s-6)">
    {% for post in collections.journal %}
    <a class="tile" href="{{ post.url }}">
      {% include "partials/frame.liquid", img: post.data.image, ratio: "journal", contain: post.data.imageContain, alt: "" %}
      <span class="tile__name">{{ post.data.title }}</span>
      <time class="tile__note" datetime="{{ post.date | date: '%Y-%m-%d' }}">{{ post.data.topic }}, {{ post.date | date: "%d.%m.%Y" }}</time>
    </a>
    {% endfor %}
  </div>
</div>
