---
layout: layouts/base.liquid
pagination: { data: site.langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{% if lang == 'de' %}/de/{% else %}/{% endif %}"
title: SENDA
en:
  description: Swiss road and gravel bikes, built around you. SENDA Vent and ORMA carbon wheels by SENDA.
  hero_alt: Two cyclists climbing Alpine switchbacks in evening light
  usp: Road and gravel bikes, built around you.
  vent_title: SENDA Vent
  vent_text: Our all-round race bike. A 780 g carbon frame with aero tube shapes, a one-piece carbon cockpit and ORMA carbon wheels, set up to your position.
  vent_weight: From 6.75 kg (without pedals)
  vent_link: Discover SENDA Vent
  vent_alt: SENDA Vent in Champagne Silver against a concrete wall
  detail_title: Considered in every detail.
  detail_text: Four finishes we designed ourselves, each with the copper S on the head tube.
  detail_alts: ["Head tube in Slate Blue with the copper S", "Frame in Dusky Rose, satin", "VENT lettering on the top tube in Slate Blue", "Frame detail in Black, glossy", "Frameset in Champagne Silver"]
  fit_label: Your position. Your build.
  fit_title: Built around you.
  fit_text: Size, cockpit, crank length, gearing, wheel depth and colour. Choose them yourself, or let four body measurements suggest them.
  fit_alt: A rider with her SENDA Vent in Champagne Silver on an Alpine pass road
  orma_title: From 1’180 g.
  orma_text: ORMA Momentum carbon wheels. Standard on every SENDA, and available on their own.
  orma_keys:
    - 1’180 g in 45/45, without rim tape
    - 45 or 50 mm, front and rear chosen separately
    - 24 mm internal width, hooked, tubeless-ready
    - 20 / 20 carbon spokes
  orma_link: Discover ORMA Momentum
  orma_alt: Pair of ORMA Momentum carbon wheels with the ORMA lettering on the rims
  gravel_title: SENDA Gravel
  gravel_text: Our race gravel bike, with aero tube shapes and room for tyres up to 55 mm. Coming mid-2027.
  gravel_cta: Notify me
  gravel_link: See the first sketch
  gravel_alt: Pencil sketch of the SENDA Gravel frame
  swiss_title: Shaped by Swiss roads.
  swiss_text: SENDA is Raphael Heeb, a materials scientist, and Micha Gamper, an architect. We grew up on Alpine passes and gravel tracks, and build the bikes we want to ride on them.
  swiss_link: About SENDA
  swiss_alt: Two cyclists on the hairpin below the Hotel Belvedere on the Furka Pass, in fog
  swiss_caption: Furka Pass, Switzerland
de:
  description: Rennräder und Gravelbikes aus der Schweiz, für Dich gebaut. SENDA Vent und ORMA Carbon-Laufräder by SENDA.
  hero_alt: Zwei Velofahrende in Alpenkehren im Abendlicht
  usp: Rennräder und Gravelbikes, für Dich gebaut.
  vent_title: SENDA Vent
  vent_text: Unser Allround-Rennrad. Ein 780 g leichter Carbonrahmen mit Aero-Rohrformen, ein einteiliges Carbon-Cockpit und ORMA Carbon-Laufräder, auf Deine Position abgestimmt.
  vent_weight: Ab 6.75 kg (ohne Pedale)
  vent_link: SENDA Vent entdecken
  vent_alt: SENDA Vent in Champagne Silver vor einer Betonwand
  detail_title: Bis ins Detail durchdacht.
  detail_text: Vier Farben, die wir selbst gestaltet haben, jede mit dem kupferfarbenen S am Steuerrohr.
  detail_alts: ["Steuerrohr in Slate Blue mit dem kupferfarbenen S", "Rahmen in Dusky Rose, seidenmatt", "VENT-Schriftzug auf dem Oberrohr in Slate Blue", "Rahmendetail in Black, glänzend", "Rahmenset in Champagne Silver"]
  fit_label: Deine Position. Dein Bike.
  fit_title: Für Dich gebaut.
  fit_text: Grösse, Cockpit, Kurbellänge, Übersetzung, Felgenhöhe und Farbe. Wähle sie selbst, oder lass sie Dir aus vier Körpermassen vorschlagen.
  fit_alt: Eine Fahrerin mit ihrem SENDA Vent in Champagne Silver auf einer Passstrasse
  orma_title: Ab 1’180 g.
  orma_text: ORMA Momentum Carbon-Laufräder. Standard an jedem SENDA und auch einzeln erhältlich.
  orma_keys:
    - 1’180 g in 45/45, ohne Felgenband
    - 45 oder 50 mm, vorne und hinten frei wählbar
    - 24 mm Innenbreite, Hooked, tubeless-tauglich
    - 20 / 20 Carbonspeichen
  orma_link: ORMA Momentum entdecken
  orma_alt: Paar ORMA Momentum Carbon-Laufräder mit ORMA-Schriftzug auf den Felgen
  gravel_title: SENDA Gravel
  gravel_text: Unser Race-Gravelbike, mit Aero-Rohrformen und Platz für Reifen bis 55 mm. Ab Mitte 2027.
  gravel_cta: Benachrichtige mich
  gravel_link: Zur ersten Skizze
  gravel_alt: Bleistiftskizze des SENDA Gravel Rahmens
  swiss_title: Geprägt von Schweizer Strassen.
  swiss_text: SENDA sind Raphael Heeb, Materialwissenschaftler, und Micha Gamper, Architekt. Wir sind auf Alpenpässen und Schotterwegen gross geworden und bauen die Bikes, die wir dort fahren wollen.
  swiss_link: Über SENDA
  swiss_alt: Zwei Velofahrende in der Kehre unter dem Hotel Belvedere am Furkapass, im Nebel
  swiss_caption: Furkapass, Schweiz
---

{%- assign wheels = collections.products | in_category: "wheelsets", lang -%}
{%- assign momentum = wheels | first -%}
{%- assign bikes = collections.products | in_category: "bikes", lang -%}
{%- for b in bikes %}{% if b.data.status == "announced" %}{% assign gravel = b %}{% endif %}{% endfor -%}

<section class="hero4" aria-label="SENDA">
  <img src="/assets/img/web/hero-pass-2000.jpg" srcset="/assets/img/web/hero-pass-1000.jpg 1000w, /assets/img/web/hero-pass-2000.jpg 2000w" sizes="100vw" width="2000" height="1116" alt="{{ C.hero_alt }}" fetchpriority="high">
  <div class="wrap hero4__copy">
    <h1 class="display hero4__claim">Quietly fast.</h1>
    <p class="hero4__usp">{{ C.usp }}</p>
  </div>
</section>

<section class="sec">
  <div class="wrap g">
    <h2 class="h2 tab-a">{{ C.vent_title }}</h2>
    <div class="tab-b">
      <p class="sec__text">{{ C.vent_text }}</p>
      <p class="facts">{{ C.vent_weight }}</p>
      {% include "partials/offer.liquid", key: "vent", class: "offer--facts" %}
      <a class="linkline" href="{{ '/bikes/vent/' | lurl: lang }}">{{ C.vent_link }}</a>
    </div>
  </div>
</section>

<figure class="bleed">
  <img src="/assets/img/web/vent-arch-champagne-2000.jpg" srcset="/assets/img/web/vent-arch-champagne-1000.jpg 1000w, /assets/img/web/vent-arch-champagne-2000.jpg 1679w" sizes="100vw" width="1679" height="937" alt="{{ C.vent_alt }}" loading="lazy">
</figure>

<section class="sec sec--tight-bottom">
  <div class="wrap g">
    <p class="sec__text tab-a">{{ C.detail_text }}</p>
    <h2 class="h2 tab-b">{{ C.detail_title }}</h2>
  </div>
</section>
<section class="strip" aria-label="{{ C.detail_title }}">
  <div class="strip__track" data-strip tabindex="0">
    {% assign dimgs = "detail-slate-headtube,detail-rose-frame,detail-vent-lettering,frame-black-detail,frame-champagne" | split: "," %}
    {% for d in dimgs %}<img src="/assets/img/web/{{ d }}-1000.jpg" alt="{{ C.detail_alts[forloop.index0] }}" loading="lazy">{% endfor %}
  </div>
  <div class="wrap strip__nav"><button type="button" class="strip__btn" data-strip-prev aria-label="{{ t.a11y.prev | default: 'Previous' }}">←</button><button type="button" class="strip__btn" data-strip-next aria-label="{{ t.a11y.next | default: 'Next' }}">→</button></div>
</section>

<section class="cover">
  <img src="/assets/img/web/rider-champagne-alps-2000.jpg" srcset="/assets/img/web/rider-champagne-alps-1000.jpg 1000w, /assets/img/web/rider-champagne-alps-2000.jpg 2000w" sizes="100vw" width="2000" height="1116" alt="{{ C.fit_alt }}" loading="lazy">
  <div class="wrap g cover__copy">
    <div class="tab-a">
      <p class="label">{{ C.fit_label }}</p>
      <h2 class="h2">{{ C.fit_title }}</h2>
      <p class="sec__text">{{ C.fit_text }}</p>
      <a class="btn btn--light" href="{{ '/bikes/vent/configure/' | lurl: lang }}">{{ t.buy.configure_vent }}</a>
    </div>
  </div>
</section>

<section class="duo">
  <div class="duo__text">
    <div class="duo__inner">
      <p class="label">ORMA / {{ t.product.orma_by }}</p>
      <h2 class="h2">{{ C.orma_title }}</h2>
      <p class="sec__text">{{ C.orma_text }}</p>
      <ul class="facts-list">{% for k in C.orma_keys %}<li>{{ k }}</li>{% endfor %}</ul>
      <a class="linkline" href="{{ momentum.url }}">{{ C.orma_link }}</a>
    </div>
  </div>
  <div class="duo__media duo__media--contain"><img src="/assets/img/web/orma-momentum-pair-1000.jpg" srcset="/assets/img/web/orma-momentum-pair-1000.jpg 1000w, /assets/img/web/orma-momentum-pair-2000.jpg 1900w" sizes="50vw" width="1900" height="1300" alt="{{ C.orma_alt }}" loading="lazy"></div>
</section>

{% if gravel %}
<section class="duo duo--grey duo--flip" aria-labelledby="gravel-title">
  <div class="duo__media duo__media--sketch"><img src="/assets/img/web/gravel-frame-sketch-1000.jpg" srcset="/assets/img/web/gravel-frame-sketch-1000.jpg 1000w, /assets/img/web/gravel-frame-sketch-2000.jpg 2000w" sizes="50vw" width="2000" height="2000" alt="{{ C.gravel_alt }}" loading="lazy"></div>
  <div class="duo__text">
    <div class="duo__inner">
      <h2 class="h2" id="gravel-title">{{ C.gravel_title }}</h2>
      <p class="sec__text">{{ C.gravel_text }}</p>
      <form class="js-signup inline-signup" data-list="gravel" novalidate>
        <div class="signup__form">
          <label class="visually-hidden" for="gravel-email">{{ t.signup.email }}</label>
          <input class="field" id="gravel-email" name="email" type="email" placeholder="{{ t.signup.email }}" autocomplete="email" required>
          <button type="submit">{{ C.gravel_cta }}</button>
        </div>
        <label class="consent"><input type="checkbox" name="consent" required> {{ t.signup.consent }} <a href="/legal/privacy.html">{{ t.signup.privacy }}</a></label>
        <p class="form-msg" role="status" aria-live="polite"></p>
      </form>
      <a class="linkline" href="{{ gravel.url }}">{{ C.gravel_link }}</a>
    </div>
  </div>
</section>
{% endif %}

<section class="sec">
  <div class="wrap g">
    <h2 class="h2 tab-a">{{ C.swiss_title }}</h2>
    <div class="tab-b">
      <p class="sec__text">{{ C.swiss_text }}</p>
      <a class="linkline" href="{{ '/about/' | lurl: lang }}">{{ C.swiss_link }}</a>
    </div>
  </div>
</section>

<figure class="bleed bleed--caption">
  <img src="/assets/img/web/belvedere-pass-2000.jpg" srcset="/assets/img/web/belvedere-pass-1000.jpg 1000w, /assets/img/web/belvedere-pass-2000.jpg 2000w" sizes="100vw" alt="{{ C.swiss_alt }}" loading="lazy">
  <figcaption class="wrap label">{{ C.swiss_caption }}</figcaption>
</figure>
