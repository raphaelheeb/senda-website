---
layout: layouts/base.liquid
permalink: /
title: SENDA
description: Swiss road and gravel bikes, made for the way out. ORMA wheels and components by SENDA.
---
{%- comment -%} One idea per section: a headline, at most one sentence, one link. {%- endcomment -%}
{%- assign bikes = collections.products | in_category: "bikes" -%}
{%- assign wheels = collections.products | in_category: "wheelsets" -%}
{%- assign clothes = collections.products | in_category: "clothing" -%}
{%- assign jersey = clothes | first -%}
{%- assign momentum = wheels | first -%}

<section class="opening" aria-label="SENDA">
  <picture>
    <source media="(max-width: 760px)" srcset="/assets/img/web/lake-road-mobile-900.jpg">
    <img src="/assets/img/web/lake-road-2000.jpg" srcset="/assets/img/web/lake-road-1000.jpg 1000w, /assets/img/web/lake-road-2000.jpg 2000w" sizes="100vw" width="2730" height="1536" alt="Two cyclists on a lakeside road in the Engadin in autumn" fetchpriority="high">
  </picture>
  <div class="wrap opening__copy">
    <h1 class="display">Quietly fast.</h1>
    <div class="opening__order">
      <p class="opening__line">SENDA Vent is open for orders.</p>
      {% include "partials/offer.liquid", key: "vent", class: "offer--light" %}
      <a class="btn btn--light" href="/bikes/vent/configure/">Configure yours</a>
    </div>
  </div>
</section>

<section class="section moment">
  <div class="wrap moment__copy">
    <h2 class="h2">SENDA Vent.</h2>
    <p class="block__text">Race geometry, a one-piece carbon cockpit and ORMA wheels, set up to your position.</p>
    <a class="linkline" href="/bikes/vent/">Discover SENDA Vent</a>
  </div>
  <div class="wrap">
    <a class="moment__image" href="/bikes/vent/" tabindex="-1" aria-hidden="true">
      <img src="/assets/img/web/road-toni-side-2000.jpg" srcset="/assets/img/web/road-toni-side-1000.jpg 1000w, /assets/img/web/road-toni-side-2000.jpg 2000w" sizes="(max-width: 1600px) 92vw, 1376px" width="2000" height="1333" alt="" loading="lazy">
    </a>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">Road now. Gravel next.</h2>
    <div class="duo">
      {% for b in bikes %}
      <a class="tile" href="{{ b.url }}">
        {% assign img = b.data.tileImage | default: b.data.image | replace: "-2000", "-1000" %}{% assign tpos = b.data.imagePosition %}{% if b.data.tileImage %}{% assign tpos = "center" %}{% endif %}{% assign talt = b.data.tileAlt | default: b.data.alt %}{% include "partials/frame.liquid", img: img, ratio: "square", pos: tpos, alt: talt %}
        <span class="tile__name">{{ b.data.title }}</span>
        <span class="tile__note">{{ b.data.tileNote }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    {% include "partials/frame.liquid", img: "/assets/img/web/orma-wheels-2000.jpg", ratio: "bike", contain: true, alt: "ORMA Momentum carbon wheelset" %}
    <div class="block">
      <p class="orma-mark"><span class="orma-mark__word">ORMA</span><span class="orma-mark__by">by SENDA</span></p>
      <h2 class="h2">1’207 grams.</h2>
      <p class="block__text">ORMA Momentum, both wheels in 45 mm. Choose 45 or 50 mm front and rear; standard on every SENDA.</p>
      <a class="linkline" href="{{ momentum.url }}">See ORMA Momentum</a>
    </div>
  </div>
</section>

{% if site.show.clothing %}
<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">Made for long days.</h2>
    <div class="trio">
      {% for c in jersey.data.colours %}
      <a class="tile" href="{{ jersey.url }}">
        {% include "partials/frame.liquid", img: c.image, ratio: "bike", contain: true, alt: c.alt %}
        <span class="tile__name">{{ c.name }}</span>
      </a>
      {% endfor %}
    </div>
    <a class="linkline block-link" href="/clothing/">See the clothing</a>
  </div>
</section>
{% endif %}

<section class="fullbleed" style="--pos: center 60%">
  <img src="/assets/img/web/valley-pair-2000.jpg" alt="Two cyclists riding into a wide Alpine valley" loading="lazy">
  <div class="wrap fullbleed__copy">
    <h2 class="h2">A materials scientist and an architect.</h2>
    <p class="block__text fullbleed__line">We choose and audit the carbon, design every finish, and have each bike painted and assembled in Switzerland.</p>
    <a class="linkline" href="/about/#made">How a SENDA is made</a>
  </div>
</section>

{% if collections.journal.size > 0 %}
<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">Journal</h2>
    <div class="trio">
      {% for post in collections.journal limit: 3 %}
      <a class="tile" href="{{ post.url }}">
        {% include "partials/frame.liquid", img: post.data.image, ratio: "journal", contain: post.data.imageContain, alt: "" %}
        <span class="tile__name">{{ post.data.title }}</span>
        <time class="tile__note" datetime="{{ post.date | date: '%Y-%m-%d' }}">{{ post.date | date: "%d.%m.%Y" }}</time>
      </a>
      {% endfor %}
    </div>
    <a class="linkline block-link" href="/journal/">All posts</a>
  </div>
</section>
{% endif %}
