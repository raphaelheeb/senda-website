---
layout: layouts/base.liquid
permalink: /
title: SENDA
description: Swiss road and gravel bikes, made for the way out. ORMA wheels and components by SENDA.
---
{%- comment -%} One idea per section: a headline, at most one sentence, one link. {%- endcomment -%}
{%- assign bikes = collections.products | in_category: "bikes" -%}
{%- assign wheels = collections.products | in_category: "wheelsets" -%}
{%- assign clothes = collections.products | in_category: "clothing" -%}
{%- assign jersey = clothes | first -%}
{%- assign momentum = wheels | first -%}

<section class="opening" aria-label="SENDA">
  <picture>
    <source media="(max-width: 760px)" srcset="/assets/img/web/lake-road-mobile-900.jpg">
    <img src="/assets/img/web/lake-road-2000.jpg" srcset="/assets/img/web/lake-road-1000.jpg 1000w, /assets/img/web/lake-road-2000.jpg 2000w" sizes="100vw" width="2730" height="1536" alt="Two cyclists on a lakeside road in the Engadin in autumn" fetchpriority="high">
  </picture>
  <div class="wrap opening__copy">
    <h1 class="display">Quietly fast.</h1>
    <a class="linkline" href="/bikes/">See the bikes</a>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">Road. And beyond it.</h2>
    <div class="duo">
      {% for b in bikes %}
      <a class="tile" href="{{ b.url }}">
        {% assign img = b.data.image | replace: "-2000", "-1000" %}{% include "partials/frame.liquid", img: img, ratio: "square", pos: b.data.imagePosition, alt: b.data.alt %}
        <span class="tile__name">{{ b.data.title }}</span>
        <span class="tile__note">{{ b.data.tileNote }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    {% include "partials/frame.liquid", img: "/assets/img/web/orma-wheels-2000.jpg", ratio: "bike", contain: true, alt: "ORMA Momentum 45 carbon wheelset" %}
    <div class="block">
      <p class="orma-mark"><span class="orma-mark__word">ORMA</span><span class="orma-mark__by">by SENDA</span></p>
      <h2 class="h2">Where the bike meets the road.</h2>
      <p class="block__text">ORMA wheels come on every SENDA. Momentum 45 is the first you can order.</p>
      <a class="linkline" href="{{ momentum.url }}">See Momentum 45</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">Made for long days.</h2>
    <div class="trio">
      {% for c in jersey.data.colours %}
      <a class="tile" href="{{ jersey.url }}">
        {% include "partials/frame.liquid", img: c.image, ratio: "bike", contain: true, alt: c.alt %}
        <span class="tile__name">{{ c.name }}</span>
      </a>
      {% endfor %}
    </div>
    <a class="linkline block-link" href="/clothing/">See the clothing</a>
  </div>
</section>

<section class="fullbleed" style="--pos: center 60%">
  <img src="/assets/img/web/valley-pair-2000.jpg" alt="Two cyclists riding into a wide Alpine valley" loading="lazy">
  <div class="wrap fullbleed__copy">
    <h2 class="h2">A materials scientist and an architect.</h2>
    <a class="linkline" href="/about/">Why we build bikes</a>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">Journal</h2>
    <div class="trio">
      {% for post in collections.journal limit: 3 %}
      <a class="tile" href="{{ post.url }}">
        {% include "partials/frame.liquid", img: post.data.image, ratio: "journal", contain: post.data.imageContain, alt: "" %}
        <span class="tile__name">{{ post.data.title }}</span>
        <time class="tile__note" datetime="{{ post.date | date: '%Y-%m-%d' }}">{{ post.date | date: "%d.%m.%Y" }}</time>
      </a>
      {% endfor %}
    </div>
    <a class="linkline block-link" href="/journal/">All posts</a>
  </div>
</section>
