---

{%- assign bikes = collections.products | in_category: "bikes", lang -%}
{%- assign wheels = collections.products | in_category: "wheelsets", lang -%}
{%- assign momentum = wheels | first -%}
{%- for b in bikes %}{% if b.data.status == "announced" %}{% assign gravel = b %}{% endif %}{% endfor -%}

<section class="opening" aria-label="SENDA">
  <picture>
    <source media="(max-width: 760px)" srcset="/assets/img/web/lake-road-mobile-900.jpg">
    <img src="/assets/img/web/lake-road-2000.jpg" srcset="/assets/img/web/lake-road-1000.jpg 1000w, /assets/img/web/lake-road-2000.jpg 2000w" sizes="100vw" width="2730" height="1536" alt="{{ C.hero_alt }}" fetchpriority="high">
  </picture>
  <div class="wrap opening__copy">
    <div class="opening__claim">
      <h1 class="display">Quietly fast.</h1>
      <p class="opening__line">{{ C.usp }}</p>
    </div>
    <div class="opening__order">
      <a class="btn btn--light" href="{{ '/bikes/vent/configure/' | lurl: lang }}">{{ C.hero_cta }}</a>
    </div>
  </div>
</section>

<section class="section moment">
  <div class="wrap moment__copy">
    <h2 class="h2">{{ C.vent_title }}</h2>
    <p class="block__text">{{ C.vent_text }}</p>
    {% include "partials/offer.liquid", key: "vent", class: "offer--center" %}
    <div class="moment__actions">
      <a class="btn" href="{{ '/bikes/vent/configure/' | lurl: lang }}">{{ t.buy.configure_vent }}</a>
      <a class="linkline" href="{{ '/bikes/vent/' | lurl: lang }}">{{ C.vent_link }}</a>
    </div>
  </div>
  <div class="moment__bleed">
    <a class="moment__image" href="{{ '/bikes/vent/' | lurl: lang }}" tabindex="-1" aria-hidden="true">
      <img src="/assets/img/web/vent-arch-champagne-2000.jpg" srcset="/assets/img/web/vent-arch-champagne-1000.jpg 1000w, /assets/img/web/vent-arch-champagne-2000.jpg 1679w" sizes="100vw" width="1679" height="937" alt="" loading="lazy">
    </a>
  </div>
</section>

<section class="section section--tint section--band">
  <div class="wrap split">
    {% include "partials/frame.liquid", img: "/assets/img/web/orma-wheels-2000.jpg", ratio: "bike", contain: true, alt: C.orma_alt %}
    <div class="block">
      <p class="orma-mark"><span class="orma-mark__word">{% include "svg/orma-wordmark.svg" %}</span><span class="orma-mark__by">{{ t.product.orma_by }}</span></p>
      <h2 class="h2">{{ C.orma_title }}</h2>
      <p class="block__text">{{ C.orma_text }}</p>
      <ul class="keylist">{% for k in C.orma_keys %}<li>{{ k }}</li>{% endfor %}</ul>
      <a class="linkline" href="{{ momentum.url }}">{{ C.orma_link }}</a>
    </div>
  </div>
</section>

{% if gravel %}
<section class="gravel-band" aria-labelledby="gravel-title">
  <div class="gravel-band__art" aria-hidden="true">{% include "svg/gravel-sketch.svg" %}</div>
  <div class="wrap gravel-band__copy">
    <h2 class="h2" id="gravel-title">{{ C.gravel_title }}</h2>
    <p class="block__text">{{ C.gravel_text }}</p>
    <form class="js-signup gravel-band__form" data-list="gravel" novalidate>
      <div class="signup__form">
        <label class="visually-hidden" for="gravel-email">{{ t.signup.email }}</label>
        <input class="field" id="gravel-email" name="email" type="email" placeholder="{{ t.signup.email }}" autocomplete="email" required>
        <button type="submit">{{ C.gravel_cta }}</button>
      </div>
      <label class="consent"><input type="checkbox" name="consent" required> {{ t.signup.consent }} <a href="/legal/privacy.html">{{ t.signup.privacy }}</a></label>
      <p class="form-msg" role="status" aria-live="polite"></p>
    </form>
    <a class="linkline" href="{{ gravel.url }}">{{ C.gravel_link }}</a>
  </div>
</section>
{% endif %}

<section class="fullbleed" style="--pos: center 60%">
  <img src="/assets/img/web/belvedere-pass-2000.jpg" alt="{{ C.founders_alt }}" loading="lazy">
  <div class="wrap fullbleed__copy">
    <h2 class="h2">{{ C.founders_title }}</h2>
    <p class="block__text fullbleed__line">{{ C.founders_text }}</p>
    <a class="linkline" href="{{ '/about/' | lurl: lang }}">{{ C.founders_link }}</a>
  </div>
</section>
