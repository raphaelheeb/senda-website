---
layout: layouts/base.liquid
pagination: { data: site.langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{% if lang == 'de' %}/de/{% else %}/{% endif %}"
title: SENDA
en:
  description: Swiss road and gravel bikes, made for the way out. ORMA wheels and components by SENDA.
  hero_alt: Two cyclists on a lakeside road in the Engadin in autumn
  vent_text: Our all-round race bike with aero-optimized geometry. A 780 g carbon frame (size 54), a fully integrated carbon cockpit, stiff ORMA carbon wheels at 1’207 g and room for 33 mm tyres. Customized to your position.
  vent_link: Discover SENDA Vent
  range: Road now. Gravel next.
  orma_title: 1’207 grams.
  orma_text: ORMA Momentum, both wheels in 45 mm. Standard on every SENDA.
  orma_keys:
    - Aero-optimized carbon rims, 45 or 50 mm deep
    - 24.8 mm internal width
    - Hooked, tubeless-ready
    - 20 / 20 carbon spokes, 3.8 mm
    - 1’207 g in 45/45, incl. rim tape
  orma_link: See ORMA Momentum
  orma_alt: ORMA Momentum carbon wheelset
  clothing_title: Made for long days.
  clothing_link: See the clothing
  founders_alt: Two cyclists on the hairpin below the Hotel Belvedere on the Furka Pass, in fog
  founders_title: When materials science meets architecture and design.
  founders_text: We are passionate cyclists who love bikes made from high-performance materials, with a clean and calm design.
  founders_link: How SENDA evolved
  journal: Journal
  journal_link: All posts
de:
  description: Rennräder und Gravelbikes aus der Schweiz, gemacht für den Weg hinaus. ORMA Laufräder und Komponenten by SENDA.
  hero_alt: Zwei Velofahrende auf einer Seestrasse im Engadin im Herbst
  vent_text: Unser Allround-Rennrad mit aerooptimierter Geometrie. Ein 780 g leichter Carbonrahmen (Grösse 54), ein voll integriertes Carbon-Cockpit, steife ORMA Carbon-Laufräder mit 1’207 g und Platz für 33 mm Reifen. Auf Deine Position abgestimmt.
  vent_link: SENDA Vent entdecken
  range: Jetzt Strasse. Bald Gravel.
  orma_title: 1’207 Gramm.
  orma_text: ORMA Momentum, beide Laufräder in 45 mm. Standard an jedem SENDA.
  orma_keys:
    - Aerooptimierte Carbonfelgen, 45 oder 50 mm hoch
    - 24.8 mm Innenbreite
    - Hooked, tubeless-tauglich
    - 20 / 20 Carbonspeichen, 3.8 mm
    - 1’207 g in 45/45, inkl. Felgenband
  orma_link: Zu ORMA Momentum
  orma_alt: ORMA Momentum Carbon-Laufradsatz
  clothing_title: Gemacht für lange Tage.
  clothing_link: Zur Bekleidung
  founders_alt: Zwei Velofahrende in der Kehre unter dem Hotel Belvedere am Furkapass, im Nebel
  founders_title: Wo Materialwissenschaft auf Architektur und Design trifft.
  founders_text: Wir sind leidenschaftliche Velofahrer und lieben Bikes aus Hochleistungsmaterialien, mit klarem, ruhigem Design.
  founders_link: Wie SENDA entstand
  journal: Journal
  journal_link: Alle Beiträge
---
{%- comment -%} One idea per section: a headline, at most one sentence, one link. {%- endcomment -%}
{%- assign bikes = collections.products | in_category: "bikes", lang -%}
{%- assign wheels = collections.products | in_category: "wheelsets", lang -%}
{%- assign clothes = collections.products | in_category: "clothing", lang -%}
{%- assign jersey = clothes | first -%}
{%- assign momentum = wheels | first -%}

<section class="opening" aria-label="SENDA">
  <picture>
    <source media="(max-width: 760px)" srcset="/assets/img/web/lake-road-mobile-900.jpg">
    <img src="/assets/img/web/lake-road-2000.jpg" srcset="/assets/img/web/lake-road-1000.jpg 1000w, /assets/img/web/lake-road-2000.jpg 2000w" sizes="100vw" width="2730" height="1536" alt="{{ C.hero_alt }}" fetchpriority="high">
  </picture>
  <div class="wrap opening__copy">
    <h1 class="display">Quietly fast.</h1>
    <div class="opening__order">
      {% include "partials/offer.liquid", key: "vent", class: "offer--light" %}
      <a class="btn btn--light" href="{{ '/bikes/vent/configure/' | lurl: lang }}">{{ t.buy.configure_vent }}</a>
    </div>
  </div>
</section>

<section class="section moment">
  <div class="wrap moment__copy">
    <h2 class="h2">SENDA Vent</h2>
    <p class="block__text">{{ C.vent_text }}</p>
    <a class="linkline" href="{{ '/bikes/vent/' | lurl: lang }}">{{ C.vent_link }}</a>
  </div>
  <div class="wrap">
    <a class="moment__image" href="{{ '/bikes/vent/' | lurl: lang }}" tabindex="-1" aria-hidden="true">
      <img src="/assets/img/web/vent-arch-champagne-2000.jpg" srcset="/assets/img/web/vent-arch-champagne-1000.jpg 1000w, /assets/img/web/vent-arch-champagne-2000.jpg 1679w" sizes="(max-width: 1600px) 92vw, 1376px" width="1679" height="937" alt="" loading="lazy">
    </a>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">{{ C.range }}</h2>
    <div class="duo">
      {% for b in bikes %}
      <a class="tile" href="{{ b.url }}">
        {% assign img = b.data.tileImage | default: b.data.image | replace: "-2000", "-1000" %}{% assign tpos = b.data.imagePosition %}{% if b.data.tileImage %}{% assign tpos = "center" %}{% endif %}{% assign talt = b.data.L.tileAlt | default: b.data.tileAlt | default: b.data.L.alt | default: b.data.alt %}{% include "partials/frame.liquid", img: img, ratio: "square", pos: tpos, alt: talt %}
        <span class="tile__name">{{ b.data.title }}</span>
        <span class="tile__note">{{ b.data.L.tileNote | default: b.data.tileNote }}</span>
        {% if b.data.status == "announced" %}<span class="tile__link linkline">{{ t.tile.notify }}</span>{% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--tint section--band">
  <div class="wrap split">
    {% include "partials/frame.liquid", img: "/assets/img/web/orma-wheels-2000.jpg", ratio: "bike", contain: true, alt: C.orma_alt %}
    <div class="block">
      <p class="orma-mark"><span class="orma-mark__word">{% include "svg/orma-wordmark.svg" %}</span><span class="orma-mark__by">{{ t.product.orma_by }}</span></p>
      <h2 class="h2">{{ C.orma_title }}</h2>
      <p class="block__text">{{ C.orma_text }}</p>
      <ul class="keylist">{% for k in C.orma_keys %}<li>{{ k }}</li>{% endfor %}</ul>
      <a class="linkline" href="{{ momentum.url }}">{{ C.orma_link }}</a>
    </div>
  </div>
</section>

{% if site.show.clothing %}
<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">{{ C.clothing_title }}</h2>
    <div class="trio">
      {% for c in jersey.data.colours %}
      <a class="tile" href="{{ jersey.url }}">
        {% include "partials/frame.liquid", img: c.image, ratio: "bike", contain: true, alt: c.alt %}
        <span class="tile__name">{{ c.name }}</span>
      </a>
      {% endfor %}
    </div>
    <a class="linkline block-link" href="{{ '/clothing/' | lurl: lang }}">{{ C.clothing_link }}</a>
  </div>
</section>
{% endif %}

<section class="fullbleed" style="--pos: center 60%">
  <img src="/assets/img/web/belvedere-pass-2000.jpg" alt="{{ C.founders_alt }}" loading="lazy">
  <div class="wrap fullbleed__copy">
    <h2 class="h2">{{ C.founders_title }}</h2>
    <p class="block__text fullbleed__line">{{ C.founders_text }}</p>
    <a class="linkline" href="{{ '/about/' | lurl: lang }}">{{ C.founders_link }}</a>
  </div>
</section>

{% if collections.journal.size > 0 and lang != "de" %}
<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">{{ C.journal }}</h2>
    <div class="trio">
      {% for post in collections.journal limit: 3 %}
      <a class="tile" href="{{ post.url }}">
        {% include "partials/frame.liquid", img: post.data.image, ratio: "journal", contain: post.data.imageContain, alt: "" %}
        <span class="tile__name">{{ post.data.title }}</span>
        <time class="tile__note" datetime="{{ post.date | date: '%Y-%m-%d' }}">{{ post.date | date: "%d.%m.%Y" }}</time>
      </a>
      {% endfor %}
    </div>
    <a class="linkline block-link" href="/journal/">{{ C.journal_link }}</a>
  </div>
</section>
{% endif %}
