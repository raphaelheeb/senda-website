---
layout: layouts/base.liquid
title: Order ORMA Momentum
permalink: /wheelsets/orma-momentum/configure/
description: Choose the rim depth front and rear for your ORMA Momentum wheelset. Paid in full by invoice.
hideSignup: true
eleventyExcludeFromCollections: true
---
{%- assign m = configurator.momentum -%}
<div class="wrap">
  <nav class="crumbs" style="padding-top: var(--s-4)" aria-label="Breadcrumb"><a href="/wheelsets/">Wheelsets</a><span>/</span><a href="/wheelsets/orma-momentum/">{{ m.name }}</a><span>/</span><span>Order</span></nav>
  <header class="page-head">
    <h1 class="h1">Order {{ m.name }}.</h1>
    <p class="lead">Binding order, paid in full by invoice. Delivery from March 2027. {{ configurator.vatNote }} Shipping within Switzerland CHF {{ configurator.shipping.price }}.</p>
  </header>

  <noscript><p class="lead">The order form needs JavaScript. You can also order by email: <a class="linkline" href="mailto:{{ configurator.orderEmail }}">{{ configurator.orderEmail }}</a></p></noscript>

  <form class="config" data-order="momentum" novalidate>
    <div>
      <fieldset class="config__step">
        <div class="config__step-head"><span class="micro config__n">1</span><legend class="h3">Rim depth</legend></div>
        <p class="small">Front and rear are chosen separately. Same price for every combination.</p>
        <p class="option-label mt-3">Front</p>
        <div class="chips">{% for r in m.rims %}<label class="chip"><input type="radio" name="rimFront" value="{{ r }}"><span>{{ r }} mm</span></label>{% endfor %}</div>
        <p class="option-label mt-3">Rear</p>
        <div class="chips">{% for r in m.rims %}<label class="chip"><input type="radio" name="rimRear" value="{{ r }}"><span>{{ r }} mm</span></label>{% endfor %}</div>
      </fieldset>

      {% include "partials/order-details.liquid", stepNo: "2", submitLabel: "Place binding order", termsNote: "I understand that this order is binding." %}
    </div>

    {% include "partials/order-summary.liquid", productName: m.name, image: "/assets/img/web/orma-wheels-1000.jpg" %}
  </form>

  {% include "partials/order-done.liquid" %}
</div>
<script id="order-config" type="application/json">{{ configurator | json }}</script>
<script type="module" src="/scripts/configure.js"></script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
