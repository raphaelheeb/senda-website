{
  "layout": "layouts/product.liquid",
  "tags": [],
  "permalink": "{% if lang == 'de' %}/de{% endif %}/{{ category }}/{{ page.fileSlug }}/",
  "promise": [
    [
      "Free delivery",
      "in Switzerland."
    ],
    [
      "30 days",
      "to return unused items."
    ],
    [
      "Questions?",
      "We answer within one working day."
    ]
