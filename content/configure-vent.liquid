---
layout: layouts/base.liquid
title: Configure SENDA Vent
permalink: /bikes/vent/configure/
description: Choose size, colour, groupset, wheels, cockpit and tyres for your SENDA Vent. Binding order with a 20% deposit by invoice.
hideSignup: true
eleventyExcludeFromCollections: true
---
{%- assign v = configurator.vent -%}
{%- comment -%}
  One row per choice. Each row shows its current value and opens on tap (one at a time).
  Every row starts with a sensible value, so a customer can go straight to "Continue".
  Stage 1 builds the bike, stage 2 asks for the details. Behaviour: /scripts/configure.js
{%- endcomment -%}
<div class="wrap order-page">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/bikes/">Bikes</a><span>/</span><a href="/bikes/vent/">{{ v.name }}</a><span>/</span><span>Configure</span></nav>

  <noscript><p class="lead">The configurator needs JavaScript. You can also order by email: <a class="linkline" href="mailto:{{ configurator.orderEmail }}">{{ configurator.orderEmail }}</a></p></noscript>

  <form class="config" data-order="vent" data-stage="build" novalidate>
    <div class="config__main">
      <header class="order-head">
        <h1 class="h2" data-stage-title="build">Your {{ v.name }}.</h1>
        <h1 class="h2" data-stage-title="details" hidden>Your details.</h1>
        <p class="order-head__offer" data-offer-until="{{ v.earlyBird.until }}">{{ v.earlyBird.label }} until {{ v.earlyBird.until | long_date }}: CHF {{ v.earlyBird.discount }} off every build.</p>
      </header>

      <div class="config__build">
        <details class="cstep" name="cstep" open>
          <summary><span class="cstep__title">Size</span><span class="cstep__value" data-show="size"></span></summary>
          <div class="cstep__body">
            <div class="chips">{% for s in v.sizes %}<label class="chip"><input type="radio" name="size" value="{{ s.id }}"><span>{{ s.label }} <em>{{ s.cm }} cm</em></span></label>{% endfor %}</div>
            <details class="more">
              <summary>Find your size</summary>
              <div class="more__body">
                <label class="more__height">Your height<input class="field" type="number" min="140" max="210" inputmode="numeric" placeholder="cm" data-height></label>
                <p class="more__result" data-height-result aria-live="polite"></p>
                <table class="more__table"><thead><tr><th>Size</th><th>Height</th><th>Stack / reach</th></tr></thead><tbody>
                  {% for s in v.sizes %}<tr><td>{{ s.label }}</td><td>{{ s.height[0] }}–{{ s.height[1] }} cm</td><td>{{ s.stack }} / {{ s.reach }} mm</td></tr>{% endfor %}
                </tbody></table>
                <p class="small">A guide, not a fitting. For a fitting: <a href="mailto:{{ configurator.orderEmail }}?subject=Fitting%20SENDA%20Vent">{{ configurator.orderEmail }}</a></p>
              </div>
            </details>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">Colour</span><span class="cstep__value" data-show="finish"></span></summary>
          <div class="cstep__body">
            <div class="swatches">{% for f in v.finishes %}<label class="swatch"><input type="radio" name="finish" value="{{ f.id }}"><span class="swatch__dot" style="background:{{ f.hex }}"></span><span class="swatch__name">{{ f.label }}<em>{{ f.surface }}</em></span></label>{% endfor %}</div>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">Groupset</span><span class="cstep__value" data-show="groupset"></span></summary>
          <div class="cstep__body">
            <div class="rows">{% for g in v.groupsets %}<label class="row"><input type="radio" name="groupset" value="{{ g.id }}"><span class="row__name">{{ g.label }}</span><span class="row__price" data-groupset-price="{{ g.id }}">CHF {{ g.price | chf }}</span></label>{% endfor %}</div>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">Gearing</span><span class="cstep__value" data-show="gearing"></span></summary>
          <div class="cstep__body">
            <p class="option-label">Crank length</p>
            <div class="chips">{% for c in v.cranks %}<label class="chip"><input type="radio" name="crank" value="{{ c }}"><span>{{ c }}</span></label>{% endfor %}</div>
            <p class="option-label">Chainrings</p>
            <div class="chips">{% for c in v.chainrings %}<label class="chip"><input type="radio" name="chainring" value="{{ c.id }}"><span>{{ c.label }}</span></label>{% endfor %}</div>
            <p class="option-label">Cassette</p>
            <div class="chips">{% for c in v.cassettes %}<label class="chip"><input type="radio" name="cassette" value="{{ c.id }}"><span>{{ c.label }}</span></label>{% endfor %}</div>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">Wheels</span><span class="cstep__value" data-show="wheels"></span></summary>
          <div class="cstep__body">
            <p class="option-label">ORMA Momentum, front</p>
            <div class="chips">{% for r in v.rims %}<label class="chip"><input type="radio" name="rimFront" value="{{ r }}"><span>{{ r }} mm</span></label>{% endfor %}</div>
            <p class="option-label">Rear</p>
            <div class="chips">{% for r in v.rims %}<label class="chip"><input type="radio" name="rimRear" value="{{ r }}"><span>{{ r }} mm</span></label>{% endfor %}</div>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">Cockpit</span><span class="cstep__value" data-show="cockpit"></span></summary>
          <div class="cstep__body">
            <p class="cstep__hint">Set for your size. One-piece carbon bar and stem.</p>
            <p class="option-label">Bar width at the hoods</p>
            <div class="chips">{% for b in v.bars %}<label class="chip"><input type="radio" name="bar" value="{{ b }}"><span>{{ b }}</span></label>{% endfor %}</div>
            <p class="option-label">Stem length</p>
            <div class="chips">{% for s in v.stems %}<label class="chip"><input type="radio" name="stem" value="{{ s }}"><span>{{ s }}</span></label>{% endfor %}</div>
            <p class="option-label">Spacers</p>
            <div class="chips">{% for s in v.spacers %}<label class="chip"><input type="radio" name="spacers" value="{{ s }}"><span>{{ s }}</span></label>{% endfor %}</div>
            <p class="cstep__hint">All values in mm. At the drops the bar is 20 mm wider.</p>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">Tyres</span><span class="cstep__value" data-show="tyre"></span></summary>
          <div class="cstep__body">
            <p class="option-label">{{ v.tyreModel }}</p>
            <div class="chips">{% for t in v.tyres %}<label class="chip"><input type="radio" name="tyre" value="{{ t.id }}"><span>{{ t.label }}</span></label>{% endfor %}</div>
          </div>
        </details>

        <div class="config__next">
          <button class="btn" type="button" data-go="details">Continue</button>
          <p class="small">Other parts or a fitting: <a href="mailto:{{ configurator.orderEmail }}">{{ configurator.orderEmail }}</a></p>
        </div>
      </div>

      <div class="config__details" hidden>
        <button class="back" type="button" data-go="build">Back to your bike</button>
        {% include "partials/order-details.liquid", submitLabel: "Place binding order", termsNote: "I understand that this order is binding and that the deposit is not refunded if I withdraw." %}
      </div>
    </div>

    {% include "partials/order-summary.liquid", productName: v.name, image: "/assets/img/web/road-toni-studio-1000.jpg", terms: "Binding order. Delivery from March 2027." %}
  </form>

  {% include "partials/order-done.liquid" %}
</div>

<div class="order-bar" data-order-bar hidden>
  <div><span class="order-bar__label">Total</span> <strong data-bar-total></strong></div>
  <button class="btn btn--small" type="button" data-go="details">Continue</button>
</div>

<script id="order-config" type="application/json">{{ configurator | json }}</script>
<script id="order-images" type="application/json">{ {% for f in finishes %}{% if f.name == "Slate Blue" %}"{{ f.name }}": "/assets/img/web/road-toni-studio-1000.jpg",{% elsif f.image %}"{{ f.name }}": "{{ f.image }}",{% endif %}{% endfor %} "_": "" }</script>
<script type="module" src="/scripts/configure.js"></script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
