---
layout: layouts/base.liquid
title: Configure SENDA Vent
pagination: { data: site.langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{% if lang == 'de' %}/de{% endif %}/bikes/vent/configure/"
de:
  title: SENDA Vent konfigurieren
  description: Wähle Grösse, Farbe, Schaltgruppe, Laufräder, Cockpit und Reifen für Dein SENDA Vent. Verbindliche Bestellung mit 30 % Anzahlung auf Rechnung.
description: Choose size, colour, groupset, wheels, cockpit and tyres for your SENDA Vent. Binding order with a 30% deposit by invoice.
hideSignup: true
---
{%- assign v = configurator.vent -%}
{%- assign c = t.config -%}
{%- comment -%}
  One row per choice. Each row shows its current value and opens on tap (one at a time).
  Every row starts with a sensible value, so a customer can go straight to "Continue".
  Stage 1 builds the bike, stage 2 asks for the details. Behaviour: /scripts/configure.js
{%- endcomment -%}
<div class="wrap order-page">
  <nav class="crumbs" aria-label="{{ t.a11y.breadcrumb }}"><a href="{{ '/bikes/' | lurl: lang }}">{{ t.nav["/bikes/"] }}</a><span>/</span><a href="{{ '/bikes/vent/' | lurl: lang }}">{{ v.name }}</a><span>/</span><span>{{ c.crumb_configure }}</span></nav>

  <noscript><p class="lead">{{ c.noscript }} <a class="linkline" href="mailto:{{ configurator.orderEmail }}">{{ configurator.orderEmail }}</a></p></noscript>

  <form class="config" data-order="vent" data-lang="{{ lang }}" data-stage="build" novalidate>
    <div class="config__main">
      <header class="order-head">
        <h1 class="h2" data-stage-title="build">{{ c.your | fill: "name", v.name }}</h1>
        <h1 class="h2" data-stage-title="details" hidden>{{ c.your_details }}</h1>
        <p class="order-head__offer">{{ t.offer.head_vent | fill: "discount", v.earlyBird.discount }}</p>
      </header>

      <div class="config__build">
        <details class="cstep" name="cstep" open>
          <summary><span class="cstep__title">{{ c.size }}</span><span class="cstep__value" data-show="size"></span></summary>
          <div class="cstep__body">
            <div class="chips">{% for s in v.sizes %}<label class="chip"><input type="radio" name="size" value="{{ s.id }}"><span>{{ s.label }} <em>{{ s.cm }} cm</em></span></label>{% endfor %}</div>
            <details class="more" data-fit>
              <summary>{{ c.fit.open }}</summary>
              <div class="more__body">
                <p class="more__intro">{{ c.fit.intro }}</p>
                <div class="fitcalc__fields">
                  <label>{{ c.fit.height }}<input class="field" type="number" name="fitHeight" inputmode="decimal" min="145" max="210" step="0.5" placeholder="cm"></label>
                  <label>{{ c.fit.inseam }}<input class="field" type="number" name="fitInseam" inputmode="decimal" min="60" max="110" step="0.5" placeholder="cm"></label>
                  <label>{{ c.fit.arm }}<input class="field" type="number" name="fitArm" inputmode="decimal" min="45" max="90" step="0.5" placeholder="cm"></label>
                  <label>{{ c.fit.shoulders }} <span>{{ c.fit.optional }}</span><input class="field" type="number" name="fitShoulders" inputmode="decimal" min="30" max="55" step="0.5" placeholder="cm"></label>
                </div>
                <details class="howto">
                  <summary>{{ c.fit.how }}</summary>
                  <div class="howto__grid">
                  {% include "svg/fit-measure.svg" %}
                  <dl>
                    <dt>{{ c.fit.height }}</dt><dd>{{ c.fit.how_height }}</dd>
                    <dt>{{ c.fit.inseam }}</dt><dd>{{ c.fit.how_inseam }}</dd>
                    <dt>{{ c.fit.arm }}</dt><dd>{{ c.fit.how_arm }}</dd>
                    <dt>{{ c.fit.shoulders }}</dt><dd>{{ c.fit.how_shoulders }}</dd>
                  </dl>
                  </div>
                </details>
                <div class="fitcalc__pos" role="radiogroup" aria-label="{{ c.fit.position }}">
                  {% for p in v.fit.positions %}<label class="chip"><input type="radio" name="fitPosition" value="{{ p[0] }}"{% if forloop.first %} checked{% endif %}><span>{{ c.fit.positions[p[0]] | default: p[1].label }}</span></label>{% endfor %}
                  <span class="fitcalc__posnote" data-fit-posnote>{{ t.js.fit_race }}</span>
                </div>
                <div class="fitcalc__result" data-fit-result aria-live="polite" hidden>
                  <dl data-fit-list></dl>
                  <p class="fitcalc__note" data-fit-note></p>
                  <button class="textbtn" type="button" data-fit-apply>{{ c.fit.apply }}</button>
                </div>
                <p class="fitcalc__error" data-fit-error aria-live="polite"></p>
                <p class="small">{{ c.fit.footnote }} <a href="{{ '/bikes/vent/' | lurl: lang }}#geometry">{{ c.fit.geometry_link }}</a>. {{ c.fit.fitting }} <a href="mailto:{{ configurator.orderEmail }}?subject=Fitting%20SENDA%20Vent">{{ configurator.orderEmail }}</a></p>
              </div>
            </details>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">{{ c.colour }}</span><span class="cstep__value" data-show="finish"></span></summary>
          <div class="cstep__body">
            <div class="swatches">{% for f in v.finishes %}<label class="swatch"><input type="radio" name="finish" value="{{ f.id }}"><span class="swatch__dot" style="background:{{ f.hex }}"></span><span class="swatch__name">{{ f.label }}<em>{{ t.surface[f.surface] | default: f.surface }}</em></span></label>{% endfor %}</div>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">{{ c.groupset }}</span><span class="cstep__value" data-show="groupset"></span></summary>
          <div class="cstep__body">
            <div class="rows">{% for g in v.groupsets %}<label class="row"><input type="radio" name="groupset" value="{{ g.id }}"><span class="row__name">{{ g.label }}</span><span class="row__price" data-groupset-price="{{ g.id }}">CHF {{ g.price | chf }}</span></label>{% endfor %}</div>
            <p class="option-label">{{ c.power }}</p>
            <div class="rows rows--plain" data-power>
              <label class="row"><input type="radio" name="power" value="no"><span class="row__name">{{ c.power_no }}</span></label>
              <label class="row"><input type="radio" name="power" value="yes"><span class="row__name">{{ c.power_yes }}</span><span class="row__price">+ CHF 500</span></label>
            </div>
            <p class="cstep__hint" data-power-note>{{ c.power_note }}</p>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">{{ c.gearing }}</span><span class="cstep__value" data-show="gearing"></span></summary>
          <div class="cstep__body">
            <p class="option-label">{{ c.crank }}</p>
            <div class="chips">{% for x in v.cranks %}<label class="chip"><input type="radio" name="crank" value="{{ x }}"><span>{{ x }}</span></label>{% endfor %}</div>
            <p class="option-label">{{ c.chainrings }}</p>
            <div class="chips">{% for x in v.chainrings %}<label class="chip"><input type="radio" name="chainring" value="{{ x.id }}"><span>{{ t.chainrings[x.id] | default: x.label }}</span></label>{% endfor %}</div>
            <p class="option-label">{{ c.cassette }}</p>
            <div class="chips">{% for x in v.cassettes %}<label class="chip"><input type="radio" name="cassette" value="{{ x.id }}"><span>{{ x.label }}</span></label>{% endfor %}</div>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">{{ c.wheels }}</span><span class="cstep__value" data-show="wheels"></span></summary>
          <div class="cstep__body">
            <p class="option-label">{{ c.front_orma }}</p>
            <div class="chips">{% for r in v.rims %}<label class="chip"><input type="radio" name="rimFront" value="{{ r }}"><span>{{ r }} mm</span></label>{% endfor %}</div>
            <p class="option-label">{{ c.rear }}</p>
            <div class="chips">{% for r in v.rims %}<label class="chip"><input type="radio" name="rimRear" value="{{ r }}"><span>{{ r }} mm</span></label>{% endfor %}</div>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">{{ c.cockpit }}</span><span class="cstep__value" data-show="cockpit"></span></summary>
          <div class="cstep__body">
            <p class="cstep__hint">{{ c.cockpit_hint }}</p>
            <p class="option-label">{{ c.bar }}</p>
            <div class="chips">{% for b in v.bars %}<label class="chip"><input type="radio" name="bar" value="{{ b }}"><span>{{ b }}</span></label>{% endfor %}</div>
            <p class="option-label">{{ c.stem }}</p>
            <div class="chips">{% for s in v.stems %}<label class="chip"><input type="radio" name="stem" value="{{ s }}"><span>{{ s }}</span></label>{% endfor %}</div>
            <p class="option-label">{{ c.spacers }}</p>
            <div class="rows rows--plain">
              <label class="row"><input type="radio" name="spacers" value="all"><span class="row__name">{{ c.spacers_all }}</span></label>
              <label class="row"><input type="radio" name="spacers" value="fewer"><span class="row__name">{{ c.spacers_fewer }}</span></label>
            </div>
            <p class="cstep__hint" data-spacer-note hidden>{{ c.spacers_fewer_note }}</p>
            <p class="cstep__hint">{{ c.cockpit_note }}</p>
          </div>
        </details>

        <details class="cstep" name="cstep">
          <summary><span class="cstep__title">{{ c.tyres }}</span><span class="cstep__value" data-show="tyre"></span></summary>
          <div class="cstep__body">
            <p class="option-label">{{ v.tyreModel }}</p>
            <div class="chips">{% for ty in v.tyres %}<label class="chip"><input type="radio" name="tyre" value="{{ ty.id }}"><span>{{ ty.label }}</span></label>{% endfor %}</div>
          </div>
        </details>

        <div class="config__next">
          <button class="btn" type="button" data-go="details">{{ c.continue }}</button>
          <p class="small">{{ c.other_parts }} <a href="mailto:{{ configurator.orderEmail }}">{{ configurator.orderEmail }}</a></p>
        </div>
      </div>

      <div class="config__details" hidden>
        <button class="back" type="button" data-go="build">{{ c.back_bike }}</button>
        {% include "partials/order-details.liquid", submitLabel: c.place_order, termsNote: c.terms_vent %}
      </div>
    </div>

    {% include "partials/order-summary.liquid", productName: v.name, image: "/assets/img/web/vent-studio-blue-1000.jpg", terms: c.summary_vent %}
  </form>

  {% include "partials/order-done.liquid" %}
</div>

<div class="order-bar" data-order-bar hidden>
  <div><span class="order-bar__label">{{ c.total }}</span> <strong data-bar-total></strong></div>
  <button class="btn btn--small" type="button" data-go="details">{{ c.continue }}</button>
</div>

<script id="order-config" type="application/json">{{ configurator | json }}</script>
<script id="order-images" type="application/json">{ {% for f in finishes %}{% if f.bikeImage %}"{{ f.name }}": "{{ f.bikeImage }}",{% endif %}{% endfor %} "_": "" }</script>
<script type="module" src="/scripts/configure.js"></script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
