{%- comment -%} Image in a fixed-ratio frame. `pos` sets the focal point (CSS object-position). Without an image: a labelled placeholder at the same ratio (previews only). {%- endcomment -%}
{%- assign r = ratio | default: "bike" -%}
{%- if img and img != "" -%}
<div class="frame ratio-{{ r }}{% if contain %} frame--contain{% endif %}"{% if pos %} style="--pos: {{ pos }}"{% endif %}><img src="{{ img }}" alt="{{ alt }}" loading="lazy" decoding="async"></div>
{%- else -%}
<div class="frame frame--placeholder ratio-{{ r }}"><span>{{ label | default: "Image to come" }}</span></div>
{%- endif -%}
