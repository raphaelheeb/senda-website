{%- comment -%} Price of an orderable product with the running introductory offer (no end date). key: "vent" or "momentum". Premium: no struck-through price. {%- endcomment -%}
{%- if key == "vent" -%}
  {%- assign o = configurator.vent -%}{%- assign g = o.groupsets | first -%}{%- assign now = g.price | minus: o.earlyBird.discount -%}{%- assign off = o.earlyBird.discount -%}{%- assign from = t.offer.from -%}{%- assign note = t.offer.early_note -%}
{%- else -%}
  {%- assign o = configurator.momentum -%}{%- assign now = o.earlyBird.price -%}{%- assign off = o.price | minus: o.earlyBird.price -%}{%- assign from = "" -%}{%- assign note = t.offer.intro_note -%}
{%- endif -%}
<div class="offer{% if class %} {{ class }}{% endif %}">
  <p class="offer__price">{{ from }}CHF {{ now | chf }}</p>
  <p class="offer__note">{{ note | fill: "discount", off }}</p>
</div>
