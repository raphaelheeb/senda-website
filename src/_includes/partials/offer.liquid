{%- comment -%} Price with the running offer for an orderable product. key: "vent" or "momentum". The offer hides itself after its date (site.js). {%- endcomment -%}
{%- if key == "vent" -%}
  {%- assign o = configurator.vent -%}{%- assign g = o.groupsets | first -%}{%- assign full = g.price -%}{%- assign now = full | minus: o.earlyBird.discount -%}{%- assign from = t.offer.from -%}{%- assign label = t.offer.early -%}
{%- else -%}
  {%- assign o = configurator.momentum -%}{%- assign full = o.price -%}{%- assign now = o.earlyBird.price -%}{%- assign from = "" -%}{%- assign label = t.offer.intro -%}
{%- endif -%}
<div class="offer{% if class %} {{ class }}{% endif %}" data-offer-until="{{ o.earlyBird.until }}">
  <p class="offer__price">{{ from }}CHF {{ now | chf }} <s>CHF {{ full | chf }}</s></p>
  {%- assign until_ = o.earlyBird.until | long_date: lang -%}
  <p class="offer__note">{% if key == "vent" %}{{ t.offer.early_note | fill: "discount", o.earlyBird.discount, "date", until_ }}{% else %}{{ label }} {{ t.offer.until }} {{ until_ }}{% endif %}</p>
</div>
<div class="offer{% if class %} {{ class }}{% endif %}" data-offer-after="{{ o.earlyBird.until }}" hidden>
  <p class="offer__price">{{ from }}CHF {{ full | chf }}</p>
</div>
