{%- comment -%} Customer details, terms and submit for an order. Used by every order page. {%- endcomment -%}
{%- assign dd = t.config.details -%}
<fieldset class="order-details" id="details">
  <legend class="visually-hidden">{{ dd.legend }}</legend>
  <div class="fit-fields order-fields">
    <label>{{ dd.first }}<input class="field" name="firstName" autocomplete="given-name" required maxlength="80"></label>
    <label>{{ dd.last }}<input class="field" name="lastName" autocomplete="family-name" required maxlength="80"></label>
    <label>{{ dd.email }}<input class="field" name="email" type="email" autocomplete="email" required maxlength="160"></label>
    <label>{{ dd.phone }}<input class="field" name="phone" type="tel" autocomplete="tel" required maxlength="40" placeholder="{{ dd.phone_placeholder }}"></label>
    <label class="order-fields__wide">{{ dd.street }}<input class="field" name="street" autocomplete="street-address" required maxlength="120"></label>
    <label>{{ dd.zip }}<input class="field" name="zip" inputmode="numeric" autocomplete="postal-code" required pattern="[1-9][0-9]{3}" maxlength="10"></label>
    <label>{{ dd.city }}<input class="field" name="city" autocomplete="address-level2" required maxlength="80"></label>
    <label class="order-fields__wide">{{ dd.country }}<input class="field" value="{{ dd.country_value }}" disabled></label>
    <label class="order-fields__wide">{{ dd.message }}<textarea class="field field--area" name="message" rows="3" maxlength="1000" placeholder="{{ dd.message_placeholder }}"></textarea></label>
  </div>
  {%- capture termsA -%}<a href="{{ '/terms/' | lurl: lang }}" target="_blank">{{ dd.terms_link }}</a>{%- endcapture -%}
  {%- capture privacyA -%}<a href="/legal/privacy.html" target="_blank">{{ dd.privacy_link }}</a>{%- endcapture -%}
  <label class="consent mt-3"><input type="checkbox" name="terms" required> <span>{{ dd.accept | fill: "terms", termsA, "privacy", privacyA }} {{ termsNote }}</span></label>
  <label class="consent mt-2"><input type="checkbox" name="newsletter"> <span>{{ dd.newsletter }}</span></label>
  <div class="cf-turnstile mt-3" data-sitekey="{{ site.turnstileSiteKey }}" data-appearance="interaction-only" data-size="flexible" data-language="{{ lang | default: 'en' }}"></div>
  <button class="btn order-submit mt-3" type="submit">{{ submitLabel }}</button>
  <p class="form-msg order-msg" role="status" aria-live="polite"></p>
</fieldset>
