{%- assign v = configurator.vent -%}
{%- assign d = v.earlyBird.until | day_month: lang -%}
<a class="offer-strip" href="{{ '/bikes/vent/configure/' | lurl: lang }}" data-offer-until="{{ v.earlyBird.until }}">
  <span class="offer-strip__long">{{ t.offer.strip_long | fill: "discount", v.earlyBird.discount, "date", d }}</span>
  <span class="offer-strip__short">{{ t.offer.strip_short | fill: "discount", v.earlyBird.discount, "date", d }}</span>
  <span class="offer-strip__go">{{ t.offer.configure }}</span>
</a>
