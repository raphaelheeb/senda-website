{%- comment -%} Live summary beside an order form. Filled by /scripts/configure.js. {%- endcomment -%}
<aside class="summary" aria-label="Summary">
  <div class="summary__frame"><img src="{{ image }}" alt="" data-summary-img></div>
  <p class="summary__imgnote" data-summary-imgnote hidden></p>
  <p class="summary__name">{{ productName }}</p>
  <dl class="summary__lines" data-summary-lines></dl>
  <div class="summary__total"><span>Total</span><strong data-summary-total>–</strong></div>
  <p class="summary__pay" data-summary-pay></p>
  <p class="summary__terms">{{ terms }} Prices incl. Swiss VAT.</p>
  <details class="summary__spec">
    <summary>Full specification</summary>
    <dl data-summary-list></dl>
  </details>
</aside>
