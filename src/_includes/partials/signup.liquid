<div class="footer-signup" id="newsletter">
  <h2 class="h3">{{ t.signup.title }}</h2>
  <form class="js-signup" data-list="{{ signupList | default: 'senda' }}" novalidate>
    <div class="signup__form">
      <label class="visually-hidden" for="signup-email">{{ t.signup.email }}</label>
      <input class="field" id="signup-email" name="email" type="email" placeholder="{{ t.signup.email }}" autocomplete="email" required>
      <button type="submit">{{ t.signup.submit }}</button>
    </div>
    <label class="consent"><input type="checkbox" name="consent" required> {{ t.signup.consent }} <a href="/legal/privacy.html">{{ t.signup.privacy }}</a></label>
    <p class="form-msg" role="status" aria-live="polite"></p>
  </form>
</div>
