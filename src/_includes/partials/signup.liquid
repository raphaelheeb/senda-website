<section class="section" id="newsletter">
  <div class="wrap signup">
    <h2 class="h2">Follow the road ahead.</h2>
    <form class="js-signup" data-list="{{ signupList | default: 'senda' }}" novalidate>
      <div class="signup__form">
        <label class="visually-hidden" for="signup-email">Email address</label>
        <input class="field" id="signup-email" name="email" type="email" placeholder="Email address" autocomplete="email" required>
        <button type="submit">Sign up</button>
      </div>
      <label class="consent"><input type="checkbox" name="consent" required> A few emails a year. Unsubscribe any time. <a href="/legal/privacy.html">Privacy</a></label>
      <p class="form-msg" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
