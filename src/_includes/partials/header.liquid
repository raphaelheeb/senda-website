<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="logo" href="/" aria-label="SENDA home"><img src="/assets/logo/senda-wordmark-v22.png" alt="SENDA" width="1747" height="307"></a>

    <nav class="nav" aria-label="Main">
      {% for item in site.nav %}
      {% assign items = collections.products | in_category: item.category %}
      <div class="nav__item">
        <a class="nav__link" href="{{ item.url }}"{% if page.url contains item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        <div class="mega">
          <div class="wrap mega__inner">
            <div>
              {% if item.orma %}<p class="mega__orma orma-mark orma-mark--small"><span class="orma-mark__word">ORMA</span><span class="orma-mark__by">Wheels and components by SENDA</span></p>{% endif %}
              {% if items.size > 0 %}
              <div class="mega__products">
                {% for p in items limit: 4 %}
                <a class="mega__product" href="{{ p.url }}">
                  {% assign thumb = p.data.image | replace: "-2000", "-1000" %}{% include "partials/frame.liquid", img: thumb, ratio: "square", contain: p.data.imageContain, pos: p.data.imagePosition, alt: "", label: p.data.imageLabel %}
                  <span class="mega__product-name">{{ p.data.title }}</span>
                  {% include "partials/badge.liquid", status: p.data.status %}
                </a>
                {% endfor %}
              </div>
              {% else %}
              <p class="mega__empty">{{ item.empty }}</p>
              {% endif %}
            </div>
            <ul class="mega__links">
              <li><a href="{{ item.url }}">All {{ item.label | downcase }}</a></li>
              {% for l in item.links %}{% unless l.draft and env.production %}<li><a href="{{ l.url }}">{{ l.label }}</a></li>{% endunless %}{% endfor %}
            </ul>
          </div>
        </div>
      </div>
      {% endfor %}
      <span class="nav__sep" aria-hidden="true"></span>
      {% for l in site.secondary %}<div class="nav__item nav--secondary"><a class="nav__link" href="{{ l.url }}"{% if page.url contains l.url %} aria-current="page"{% endif %}>{{ l.label }}</a></div>{% endfor %}
    </nav>

    <div class="header-tools">
      <a class="lang" href="/de/?lang=de" aria-label="Deutsch"><strong>EN</strong> / DE</a>
      <a class="header-cta" href="#newsletter">Join the list ↗</a>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="drawer" aria-label="Menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18M3 16h18"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" data-open="false">
  {% for item in site.nav %}
  <div class="drawer__group">
    <a class="drawer__main" href="{{ item.url }}">{{ item.label }}</a>
    <ul class="drawer__sub">{% for l in item.links %}{% unless l.draft and env.production %}<li><a href="{{ l.url }}">{{ l.label }}</a></li>{% endunless %}{% endfor %}</ul>
  </div>
  {% endfor %}
  <div class="drawer__secondary">
    {% for l in site.secondary %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
    <a href="/de/?lang=de">Deutsch</a>
  </div>
  <a class="btn btn--wide" href="#newsletter">Join the list</a>
</div>
