<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="logo" href="/" aria-label="SENDA home"><img src="/assets/logo/senda-wordmark-v22.png" alt="SENDA" width="1747" height="307"></a>
    <nav class="nav" aria-label="Main">
      {% for item in site.nav %}<a class="nav__link" href="{{ item.url }}"{% if page.url contains item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
    </nav>
    <div class="header-tools">
      <span class="lang"><a href="/de/?lang=de" lang="de" hreflang="de">DE</a> / <span aria-current="true">EN</span></span>
      <a class="header-cta" href="#newsletter">Join the list</a>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="drawer" aria-label="Menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18M3 16h18"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" data-open="false">
  {% for item in site.nav %}<a class="drawer__main" href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
  <div class="drawer__secondary">
    <a href="/de/?lang=de" lang="de">Deutsch</a>
    <a href="#newsletter">Join the list</a>
  </div>
</div>
