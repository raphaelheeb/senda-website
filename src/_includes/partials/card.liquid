{%- assign cr = cardRatio | default: p.data.ratio -%}
{%- assign thumb = p.data.image | replace: "-2000", "-1000" -%}
<a class="tile" href="{{ p.url }}">
  {% include "partials/frame.liquid", img: thumb, ratio: cr, contain: p.data.imageContain, pos: p.data.imagePosition, alt: p.data.alt, label: p.data.imageLabel %}
  <span class="tile__name">{{ p.data.title }}</span>
  <span class="tile__note">{% case p.data.status %}{% when "announced" %}Announced, {{ p.data.delivery }}{% when "preorder" %}Pre-order, {{ p.data.price }}{% else %}{{ p.data.price }}{% endcase %}</span>
</a>
