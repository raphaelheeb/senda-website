{%- comment -%} Status, price and the one commercial action for a product. Content marked data-states shows only in that lifecycle state. {%- endcomment -%}
{%- assign delivery_ = L.delivery | default: delivery -%}
{%- assign price_ = L.price | default: price -%}
{%- assign priceNote_ = L.priceNote | default: priceNote -%}
<div class="buy__status">
  <span class="badge js-status-badge badge--{{ status }}">{{ t.status[status] | default: status }}</span>
  <div data-states="announced">
    {% if price_ %}<p class="buy__price">{{ price_ }} <span class="tiny">{{ t.buy.expected }}{% if priceNote_ %}, {% if lang == "de" %}{{ priceNote_ }}{% else %}{{ priceNote_ | downcase }}{% endif %}{% endif %}</span></p>{% endif %}
    <p class="buy__note">{{ t.buy.announced_note | fill: "delivery", delivery_ }}</p>
  </div>
  <div data-states="preorder">
    {% if orderKey %}{% include "partials/offer.liquid", key: orderKey %}{% else %}<p class="buy__price">{{ price_ }}{% if priceNote_ %} <span class="tiny">{{ priceNote_ }}</span>{% endif %}</p>{% endif %}
    <p class="buy__note">{% if orderKey == "vent" %}{{ t.buy.vent_note | fill: "delivery", delivery_ }}{% elsif orderKey == "momentum" %}{{ t.buy.momentum_note | fill: "delivery", delivery_ }}{% else %}{{ t.buy.delivery_note | fill: "delivery", delivery_ }}{% endif %}</p>
  </div>
  <div data-states="available">
    <p class="buy__price">{{ price_ }}{% if priceNote_ %} <span class="tiny">{{ priceNote_ }}</span>{% endif %}</p>
    <p class="buy__note">{{ L.availableNote | default: availableNote | default: t.buy.available_note }}</p>
  </div>
</div>

<form class="buy__actions js-signup" data-list="{{ list | default: 'senda' }}" data-states="announced" novalidate>
  <label class="visually-hidden" for="notify-email">{{ t.signup.email }}</label>
  <input class="field" id="notify-email" name="email" type="email" placeholder="{{ t.signup.placeholder }}" autocomplete="email">
  <button class="btn" type="submit">{{ t.signup.notify }}</button>
  <label class="consent"><input type="checkbox" name="consent"> {{ t.signup.notify_consent }}</label>
  <p class="form-msg" role="status" aria-live="polite"></p>
</form>
<div class="buy__actions" data-states="preorder">
  {% if configureUrl %}<a class="btn" href="{{ configureUrl | lurl: lang }}">{% if type == "bike" %}{{ t.buy.configure }}{% else %}{{ t.buy.order }}{% endif %}</a>{% endif %}
</div>
<div class="buy__actions" data-states="available">
  <button class="btn" type="button">{{ t.buy.order }}</button>
</div>

{% unless env.production %}
{%- assign promise_ = L.promise | default: promise -%}
<ul class="promise draft" data-draft="{{ t.buy.promise_draft }}">
  {% for p in promise_ %}<li><strong>{{ p[0] }}</strong> {{ p[1] }}</li>{% endfor %}
</ul>
{% endunless %}
