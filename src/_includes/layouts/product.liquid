---
layout: layouts/base.liquid
---
{%- assign catLabel = category | capitalize -%}
{% if type == "bike" %}
<nav class="subbar" aria-label="{{ title }}">
  <div class="wrap subbar__inner">
    <a class="subbar__name" href="#overview">{{ title }}</a>
    <span class="subbar__links">
      <a href="#overview">Overview</a>
      <a href="#colours">Colours</a>
      {% if features %}<a href="#details">Details</a>{% endif %}
      {% if specs %}<a href="#specs">Specifications</a>{% endif %}
      {% if faq %}<a href="#faq">FAQ</a>{% endif %}
    </span>
    <span class="subbar__action">
      <a class="btn btn--small" href="#buy" data-states="announced">Notify me</a>
      <a class="btn btn--small" href="#buy" data-states="preorder">Reserve</a>
      <a class="btn btn--small" href="#buy" data-states="available">Order</a>
    </span>
  </div>
</nav>

<section class="stage" id="overview">
  <div class="wrap stage__head">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/{{ category }}/">{{ catLabel }}</a><span>/</span><span>{{ title }}</span></nav>
    <h1 class="stage__title">{{ title }}</h1>
    <p class="stage__summary">{{ summary }}</p>
  </div>
  <div class="wrap">
    {% include "partials/frame.liquid", img: image, ratio: "hero", pos: imagePosition, alt: alt %}
  </div>
  <div class="wrap stage__base">
    {% if dims %}<div class="dims" style="--dims: {{ dims.size }}">
      {% for d in dims %}<div class="dim"><span class="dim__value">{{ d[0] }}</span><span class="dim__label">{{ d[1] }}</span></div>{% endfor %}
    </div>{% endif %}
    <div class="buy stage__buy" id="buy" aria-label="Purchase">
      {% include "partials/buy.liquid" %}
    </div>
  </div>
</section>
{% else %}
<div class="wrap">
  <nav class="crumbs" style="padding-top: var(--s-4)" aria-label="Breadcrumb"><a href="/{{ category }}/">{{ catLabel }}</a><span>/</span><span>{{ title }}</span></nav>

  <div class="product-top">
    <div class="gallery">
      {% include "partials/frame.liquid", img: image, ratio: ratio, contain: imageContain, pos: imagePosition, alt: alt, label: imageLabel %}
      {% if image2 or image3 %}
      <div class="gallery__thumbs">
        {% if image2 %}{% include "partials/frame.liquid", img: image2, ratio: ratio, contain: image2Contain, alt: "" %}{% endif %}
        {% if image3 %}{% include "partials/frame.liquid", img: image3, ratio: ratio, contain: image3Contain, alt: "" %}{% endif %}
      </div>
      {% endif %}
    </div>

    <aside class="buy" aria-label="Purchase">
      <div class="buy__brand">
        {% if brand == "ORMA" %}<a href="/orma/" class="orma-mark orma-mark--small"><span class="orma-mark__word">ORMA</span><span class="orma-mark__by">by SENDA</span></a>{% endif %}
      </div>
      <h1 class="buy__title">{{ title }}</h1>
      <p class="buy__summary">{{ summary }}</p>

      {% include "partials/buy.liquid" %}
    </aside>
  </div>
</div>

{% endif %}

{% if dims and type != "bike" %}
<section class="section section--tight">
  <div class="wrap">
    <div class="dims" style="--dims: {{ dims.size }}">
      {% for d in dims %}<div class="dim"><span class="dim__value">{{ d[0] }}</span><span class="dim__label">{{ d[1] }}</span></div>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if content != blank and storyImage %}
<section class="section">
  <div class="wrap split">
    <div>
      <h2 class="h2">{{ storyTitle }}</h2>
      <div class="prose mt-4">{{ content }}</div>
    </div>
    {% include "partials/frame.liquid", img: storyImage, ratio: "bike", alt: storyAlt %}
  </div>
</section>
{% endif %}

{% if type == "bike" %}
<section class="section" id="colours">
  <div class="wrap">
    <h2 class="h2 block-title">Four colours, one frame.</h2>
    <div class="picker" data-picker>
      <div class="picker__stage">
        {% for f in finishes %}
        <div class="picker__view{% if forloop.first %} is-active{% endif %}" data-finish="{{ f.name | slugify }}">
          {% if f.image %}<img src="{{ f.image | replace: '-1000', '-2000' }}" alt="SENDA frame in {{ f.name }}" loading="lazy">{% else %}<div class="picker__flat" style="background: {{ f.hex }}"></div>{% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="picker__controls" role="radiogroup" aria-label="Finish">
        {% for f in finishes %}<button type="button" class="picker__chip" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" data-finish="{{ f.name | slugify }}" data-caption="{{ f.name }}, {{ f.surface | downcase }}"><i style="background: {{ f.hex }}"></i><span>{{ f.name }}</span></button>{% endfor %}
      </div>
      {% assign f0 = finishes | first %}<p class="picker__caption micro" aria-live="polite">{{ f0.name }}, {{ f0.surface | downcase }}</p>
    </div>
  </div>
</section>

{% if features %}
<section class="section" id="details">
  <div class="wrap">
    <h2 class="h2 block-title">{{ featuresTitle | default: "Look closer." }}</h2>
    <div class="features">
      {% for f in features %}
      <article class="feature">
        {% include "partials/frame.liquid", img: f.image, ratio: "bike", contain: f.contain, pos: f.pos, alt: f.alt %}
        <details class="feature__more">
          <summary>{{ f.title }}</summary>
          <p>{{ f.text }}</p>
          {% if f.link %}<a class="linkline" href="{{ f.link }}">{{ f.linkText }}</a>{% endif %}
        </details>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% else %}
<section class="section">
  <div class="wrap">
    <div class="specced">
      {% include "partials/frame.liquid", img: "/assets/img/web/orma-wheels-1000.jpg", ratio: "bike", contain: true, alt: "ORMA Momentum 45 wheelset" %}
      <div>
        <p class="orma-mark orma-mark--small"><span class="orma-mark__word">ORMA</span><span class="orma-mark__by">by SENDA</span></p>
        {% if platform == "gravel" %}
        <h3 class="h3 mt-3">Specced with ORMA, wider for gravel</h3>
        <p class="small mt-2">A wider ORMA gravel wheelset is in development and will be standard on every {{ title }}.</p>
        {% else %}
        <h3 class="h3 mt-3">Specced with ORMA Momentum 45</h3>
        <p class="small mt-2">Every {{ title }} rolls on ORMA wheels, developed by the same team to the same standard.</p>
        {% endif %}
        <a class="linkline mt-3" href="/wheelsets/orma-momentum-45/">See the wheelset</a>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% unless env.production %}
<section class="section">
  <div class="wrap draft" data-draft="Not in launch: builds and prices to confirm">
    <div class="section-head">
      <div><h2 class="h2">Three builds.</h2></div>
      <p class="lead">Groupsets are being finalised; the lists show the structure, not final parts.</p>
    </div>
    <div class="kits">
      {% for k in kits %}
      <div class="kit"><h3 class="h3">{{ k.name }}</h3><p class="micro kit__price">{{ k.price }}</p><ul>{% for i in k.items %}<li>{{ i }}</li>{% endfor %}</ul></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="geometry">
  <div class="wrap draft" data-draft="Not in launch: geometry to confirm">
    <div class="section-head"><h2 class="h2">Geometry.</h2>{% if geometrySource %}<p class="lead">{{ geometrySource }}</p>{% else %}<p class="lead">Final numbers are published when pre-orders open.</p>{% endif %}</div>
    {% if geometryImage %}<img class="geometry-drawing" src="{{ geometryImage }}" alt="Geometry drawing of the {{ title }} frame with stack, reach and angles" loading="lazy">{% endif %}
    <div class="scroll-x">
      <table class="table table--wide">
        <thead><tr><th>Size</th>{% for s in sizes %}<th>{{ s }}</th>{% endfor %}</tr></thead>
        <tbody>
        {% if geometryRows %}
          {% for row in geometryRows %}<tr>{% for c in row %}{% if forloop.first %}<th>{{ c }}</th>{% else %}<td>{{ c }}</td>{% endif %}{% endfor %}</tr>{% endfor %}
        {% else %}
          {% for row in geometry %}<tr><th>{{ row }}</th>{% for s in sizes %}<td class="no">To come</td>{% endfor %}</tr>{% endfor %}
        {% endif %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% endunless %}
{% endif %}

{% if specs %}
<section class="section" id="specs">
  <div class="wrap split split--top">
    <div>
      <h2 class="h2">{{ specsTitle | default: "Specifications" }}</h2>
      {% if specsNote %}<p class="lead mt-3">{{ specsNote }}</p>{% endif %}
    </div>
    <table class="table">
      <tbody>{% for s in specs %}<tr><th>{{ s[0] }}</th><td>{{ s[1] }}</td></tr>{% endfor %}</tbody>
    </table>
  </div>
</section>
{% endif %}

{% if compat %}
<section class="section" id="compatibility">
  <div class="wrap">
    <div class="section-head">
      <div><h2 class="h2">Will it fit<br>my bike?</h2></div>
      <p class="lead">Check your frame against the standards below. Items marked "to confirm" are being settled with the hub supplier.</p>
    </div>
    <div class="scroll-x">
      <table class="table">
        <thead><tr><th>Your bike</th><th>Fits</th><th>Note</th></tr></thead>
        <tbody>{% for c in compat %}<tr><th>{{ c[0] }}</th><td class="{{ c[1] }}">{% case c[1] %}{% when "yes" %}Yes{% when "no" %}No{% when "planned" %}Planned{% else %}To confirm{% endcase %}</td><td>{{ c[2] }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
    {% if type == "wheelset" %}<p class="small mt-4">Standard on SENDA Road. A wider ORMA wheelset for SENDA Gravel is in development. <a class="linkline" href="/bikes/">See the bikes</a></p>{% endif %}
  </div>
</section>
{% endif %}

{% if faq %}
<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head">
      <div><h2 class="h2">Good to know.</h2></div>
      <p class="lead">Anything else: <a class="linkline" href="/service/#contact">Write to us</a></p>
    </div>
    <div class="faq">
      {% for q in faq %}<details><summary>{{ q[0] }}</summary><p>{{ q[1] }}</p></details>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if type == "bike" %}
{%- assign family = collections.products | in_category: category -%}
{%- assign wheelsets = collections.products | in_category: "wheelsets" -%}
<section class="section">
  <div class="wrap">
    <h2 class="h2 block-title">More from SENDA.</h2>
    <div class="duo">
      {% for p in family %}{% if p.url != page.url %}{% include "partials/card.liquid", p: p, cardRatio: "bike" %}{% endif %}{% endfor %}
      {% for p in wheelsets limit: 1 %}{% include "partials/card.liquid", p: p, cardRatio: "bike" %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}
