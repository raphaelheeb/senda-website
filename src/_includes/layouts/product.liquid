---
layout: layouts/base.liquid
---
{%- assign catLabel = category | capitalize -%}
<div class="wrap">
  <nav class="crumbs" style="padding-top: var(--s-4)" aria-label="Breadcrumb"><a href="/{{ category }}/">{{ catLabel }}</a><span>/</span><span>{{ title }}</span></nav>

  <div class="product-top">
    <div class="gallery">
      {% include "partials/frame.liquid", img: image, ratio: ratio, contain: imageContain, pos: imagePosition, alt: alt, label: imageLabel %}
      {% if image2 or image3 %}
      <div class="gallery__thumbs">
        {% if image2 %}{% include "partials/frame.liquid", img: image2, ratio: ratio, contain: image2Contain, alt: "" %}{% endif %}
        {% if image3 %}{% include "partials/frame.liquid", img: image3, ratio: ratio, contain: image3Contain, alt: "" %}{% endif %}
      </div>
      {% endif %}
    </div>

    <aside class="buy" aria-label="Purchase">
      <div class="buy__brand">
        {% if brand == "ORMA" %}<a href="/orma/" class="orma-mark orma-mark--small"><span class="orma-mark__word">ORMA</span><span class="orma-mark__by">by SENDA</span></a>{% endif %}
      </div>
      <h1 class="buy__title">{{ title }}</h1>
      <p class="buy__summary">{{ summary }}</p>

      <div class="buy__status">
        <span class="badge js-status-badge badge--{{ status }}">{{ status | status_label }}</span>
        <div data-states="announced">
          {% if price %}<p class="buy__price">{{ price }} <span class="tiny">Expected{% if priceNote %}, {{ priceNote | downcase }}{% endif %}</span></p>{% endif %}
          <p class="buy__note">Expected {{ delivery | default: "later" }}. Leave your email and we write first when pre-orders open.</p>
        </div>
        <div data-states="preorder">
          <p class="buy__price">{{ price }}{% if priceNote %} <span class="tiny">{{ priceNote }}</span>{% endif %}</p>
          <p class="buy__note">{% if deposit %}Reserve with a refundable {{ deposit }} deposit. {% endif %}Delivery {{ delivery }}.</p>
        </div>
        <div data-states="available">
          <p class="buy__price">{{ price }}{% if priceNote %} <span class="tiny">{{ priceNote }}</span>{% endif %}</p>
          <p class="buy__note">{{ availableNote | default: "In stock. Ships from Zürich in 2 to 3 working days." }}</p>
        </div>
      </div>

      {% for opt in options %}
      <fieldset class="buy__block" data-states="preorder available">
        <legend class="option-label">{{ opt.label }}</legend>
        <div class="chips">
          {% for v in opt.values %}
          <label class="chip"><input type="radio" name="{{ opt.label | slugify }}" {% if forloop.first %}checked{% endif %}><span>{% if v.hex %}<i style="background:{{ v.hex }}"></i>{% endif %}{{ v.name | default: v }}</span></label>
          {% endfor %}
        </div>
        {% if opt.note %}<p class="tiny mt-2">{{ opt.note }}</p>{% endif %}
      </fieldset>
      {% endfor %}

      <form class="buy__actions js-signup" data-list="{{ list | default: 'senda' }}" data-states="announced" novalidate>
        <label class="visually-hidden" for="notify-email">Email address</label>
        <input class="field" id="notify-email" name="email" type="email" placeholder="Your email address" autocomplete="email">
        <button class="btn" type="submit">Notify me</button>
        <label class="consent"><input type="checkbox" name="consent"> I agree to receive emails about this product and SENDA news.</label>
        <p class="form-msg" role="status" aria-live="polite"></p>
      </form>
      <div class="buy__actions" data-states="preorder">
        <button class="btn" type="button">{% if type == "bike" %}Reserve with {{ deposit }} deposit{% else %}Pre-order{% endif %}</button>
        {% if type == "bike" %}<a class="btn btn--quiet" href="/service/#fitting">Book a fitting first</a>{% endif %}
      </div>
      <div class="buy__actions" data-states="available">
        <button class="btn" type="button">{% if type == "bike" %}Order{% else %}Add to cart{% endif %}</button>
        {% if type == "bike" %}<a class="btn btn--quiet" href="/service/#fitting">Book a fitting first</a>{% endif %}
      </div>

      {% unless env.production %}
      <ul class="promise draft" data-draft="Service promises: to confirm">
        {% for p in promise %}<li><strong>{{ p[0] }}</strong> {{ p[1] }}</li>{% endfor %}
      </ul>
      {% endunless %}
    </aside>
  </div>
</div>

{% if dims %}
<section class="section section--tight">
  <div class="wrap">
    <div class="dims" style="--dims: {{ dims.size }}">
      {% for d in dims %}<div class="dim"><span class="dim__value">{{ d[0] }}</span><span class="dim__label">{{ d[1] }}</span></div>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if content != blank and storyImage %}
<section class="section">
  <div class="wrap split">
    <div>
      <h2 class="h2">{{ storyTitle }}</h2>
      <div class="prose mt-4">{{ content }}</div>
    </div>
    {% include "partials/frame.liquid", img: storyImage, ratio: "bike", alt: storyAlt %}
  </div>
</section>
{% endif %}

{% if type == "bike" %}
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div><h2 class="h2">Four colours,<br>one frame.</h2></div>
      <p class="lead">Each chosen to age well. Every finish is available on every build.</p>
    </div>
    <div class="swatches">
      {% for f in finishes %}<div><div class="swatch__color" style="background:{{ f.hex }}"></div><p class="swatch__name">{{ f.name }}</p><p class="micro swatch__note">{{ f.surface }}</p></div>{% endfor %}
    </div>
    <div class="specced mt-5">
      {% include "partials/frame.liquid", img: "/assets/img/web/orma-wheels-1000.jpg", ratio: "bike", contain: true, alt: "ORMA Momentum 45 wheelset" %}
      <div>
        <p class="orma-mark orma-mark--small"><span class="orma-mark__word">ORMA</span><span class="orma-mark__by">by SENDA</span></p>
        {% if platform == "gravel" %}
        <h3 class="h3 mt-3">Specced with ORMA, wider for gravel</h3>
        <p class="small mt-2">A wider ORMA gravel wheelset is in development and will be standard on every {{ title }}.</p>
        {% else %}
        <h3 class="h3 mt-3">Specced with ORMA Momentum 45</h3>
        <p class="small mt-2">Every {{ title }} rolls on ORMA wheels, developed by the same team to the same standard.</p>
        {% endif %}
        <a class="linkline mt-3" href="/wheelsets/orma-momentum-45/">See the wheelset</a>
      </div>
    </div>
  </div>
</section>

{% unless env.production %}
<section class="section">
  <div class="wrap draft" data-draft="Not in launch: builds and prices to confirm">
    <div class="section-head">
      <div><h2 class="h2">Three builds.</h2></div>
      <p class="lead">Groupsets are being finalised; the lists show the structure, not final parts.</p>
    </div>
    <div class="kits">
      {% for k in kits %}
      <div class="kit"><h3 class="h3">{{ k.name }}</h3><p class="micro kit__price">{{ k.price }}</p><ul>{% for i in k.items %}<li>{{ i }}</li>{% endfor %}</ul></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="geometry">
  <div class="wrap draft" data-draft="Not in launch: geometry to confirm">
    <div class="section-head">
      <div><h2 class="h2">Five sizes.</h2></div>
      <p class="lead">Final numbers are published when pre-orders open.</p>
    </div>
    <div class="scroll-x">
      <table class="table table--wide">
        <thead><tr><th>Measurement</th>{% for s in sizes %}<th>{{ s }}</th>{% endfor %}</tr></thead>
        <tbody>{% for row in geometry %}<tr><th>{{ row }}</th>{% for s in sizes %}<td class="no">To come</td>{% endfor %}</tr>{% endfor %}</tbody>
      </table>
    </div>
  </div>
</section>
{% endunless %}
{% endif %}

{% if specs %}
<section class="section">
  <div class="wrap split split--top">
    <div>
      <h2 class="h2">{{ specsTitle | default: "Specifications" }}</h2>
      {% if specsNote %}<p class="lead mt-3">{{ specsNote }}</p>{% endif %}
    </div>
    <table class="table">
      <tbody>{% for s in specs %}<tr><th>{{ s[0] }}</th><td>{{ s[1] }}</td></tr>{% endfor %}</tbody>
    </table>
  </div>
</section>
{% endif %}

{% if compat %}
<section class="section" id="compatibility">
  <div class="wrap">
    <div class="section-head">
      <div><h2 class="h2">Will it fit<br>my bike?</h2></div>
      <p class="lead">Check your frame against the standards below. Items marked "to confirm" are being settled with the hub supplier.</p>
    </div>
    <div class="scroll-x">
      <table class="table">
        <thead><tr><th>Your bike</th><th>Fits</th><th>Note</th></tr></thead>
        <tbody>{% for c in compat %}<tr><th>{{ c[0] }}</th><td class="{{ c[1] }}">{% case c[1] %}{% when "yes" %}Yes{% when "no" %}No{% when "planned" %}Planned{% else %}To confirm{% endcase %}</td><td>{{ c[2] }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
    {% if type == "wheelset" %}<p class="small mt-4">Standard on SENDA Road. A wider ORMA wheelset for SENDA Gravel is in development. <a class="linkline" href="/bikes/">See the bikes</a></p>{% endif %}
  </div>
</section>
{% endif %}

{% if faq %}
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div><h2 class="h2">Good to know.</h2></div>
      <p class="lead">Anything else: <a class="linkline" href="/service/#contact">Write to us</a></p>
    </div>
    <div class="faq">
      {% for q in faq %}<details><summary>{{ q[0] }}</summary><p>{{ q[1] }}</p></details>{% endfor %}
    </div>
  </div>
</section>
{% endif %}
