---
layout: layouts/base.liquid
---
{%- comment -%}
  One template for every product and both languages. Text fields come from the product's data;
  German overrides sit in its `de:` block and arrive here as L (see src/_data/eleventyComputed.js).
{%- endcomment -%}
{%- assign catKey = "/" | append: category | append: "/" -%}
{%- assign catLabel = t.nav[catKey] | default: category -%}
{%- assign summary_ = L.summary | default: summary -%}
{%- assign alt_ = L.alt | default: alt -%}
{%- assign dims_ = L.dims | default: dims -%}
{%- assign features_ = L.features | default: features -%}
{%- assign ride_ = L.ride | default: ride -%}
{%- assign faq_ = L.faq | default: faq -%}
{%- assign specs_ = L.specs | default: specs -%}
{%- assign compat_ = L.compat | default: compat -%}
{%- assign storyTitle_ = L.storyTitle | default: storyTitle -%}
{%- assign storyAlt_ = L.storyAlt | default: storyAlt -%}
{%- assign specsTitle_ = L.specsTitle | default: specsTitle | default: t.product.specifications -%}
{%- assign specsNote_ = L.specsNote | default: specsNote -%}
{%- assign sketchNote_ = L.sketchNote | default: sketchNote -%}
{%- assign sketchHidden_ = L.sketchHidden | default: sketchHidden -%}
{%- assign geometrySource_ = L.geometrySource | default: geometrySource -%}
{%- if lang == "de" and L.body -%}{%- assign body_ = L.body | md -%}{%- else -%}{%- assign body_ = content -%}{%- endif -%}
{%- assign configureHref = configureUrl | lurl: lang -%}
{% if type == "bike" %}
<nav class="subbar" aria-label="{{ title }}">
  <div class="wrap subbar__inner">
    <a class="subbar__name" href="#overview">{{ title }}</a>
    <span class="subbar__links">
      <a href="#overview">{{ t.product.overview }}</a>
      {% unless status == "announced" %}<a href="#colours">{{ t.product.colours }}</a>{% endunless %}
      {% if features_ or ride_ %}<a href="#details">{{ t.product.details }}</a>{% endif %}
      {% if specs_ %}<a href="#specs">{{ t.product.specs }}</a>{% endif %}
      {% if faq_ %}<a href="#faq">{{ t.product.faq }}</a>{% endif %}
    </span>
    <span class="subbar__action">
      <a class="btn btn--small" href="#buy" data-states="announced">{{ t.product.notify }}</a>
      <a class="btn btn--small" href="{% if configureUrl %}{{ configureHref }}{% else %}#buy{% endif %}" data-states="preorder">{{ t.product.configure }}</a>
      <a class="btn btn--small" href="#buy" data-states="available">{{ t.product.order }}</a>
    </span>
  </div>
</nav>

<section class="stage" id="overview">
  <div class="wrap g stage4">
    <div class="tab-a">
      <nav class="crumbs" aria-label="{{ t.a11y.breadcrumb }}"><a href="{{ '/' | append: category | append: '/' | lurl: lang }}">{{ catLabel }}</a><span>/</span><span>{{ title }}</span></nav>
      <h1 class="h1">{{ title }}</h1>
    </div>
    <div class="tab-b">
      <p class="sec__text">{{ summary_ }}</p>
    </div>
  </div>
  <div class="{% if sketch %}wrap{% else %}stage4__image{% endif %}">
    {% if sketch %}
    <figure class="sketch-stage" data-draw>
      {% include sketch %}
      <figcaption>
        <p class="sketch-note">{{ sketchNote_ }}</p>
        {% if sketchHidden_ %}<dl class="sketch-specs">{% for h in sketchHidden_ %}<div><dt>{{ h[0] }}</dt><dd aria-label="{{ t.product.not_published }}"><span class="blur" aria-hidden="true">{{ h[1] }}</span></dd></div>{% endfor %}</dl>{% endif %}
      </figcaption>
    </figure>
    {% else %}
    {% include "partials/frame.liquid", img: image, ratio: "hero", pos: imagePosition, alt: alt_ %}
    {% endif %}
  </div>
  <div class="wrap stage__base">
    {% if dims_ %}<div class="dims" style="--dims: {{ dims_.size }}">
      {% for d in dims_ %}<div class="dim"><span class="dim__value">{{ d[0] }}</span><span class="dim__label">{{ d[1] }}</span></div>{% endfor %}
    </div>{% endif %}
    <div class="buy stage__buy" id="buy" aria-label="{{ t.a11y.purchase }}">
      {% include "partials/buy.liquid" %}
    </div>
  </div>
</section>
{% else %}
{%- comment -%} Wheelsets and components, v4: image to the page edge, text on tab B; key figures on grey; then text sections on tab A / tab B. {%- endcomment -%}
<section class="duo duo--flip p-top" id="overview">
  <div class="duo__media duo__media--contain">
    <img src="{{ image | replace: '-1000', '-2000' }}" alt="{{ alt_ }}"{% if imagePosition %} style="object-position: {{ imagePosition }}"{% endif %}>
  </div>
  <div class="duo__text"><div class="duo__inner">
    <nav class="crumbs" aria-label="{{ t.a11y.breadcrumb }}"><a href="{{ '/' | append: category | append: '/' | lurl: lang }}">{{ catLabel }}</a><span>/</span><span>{{ title }}</span></nav>
    {% if brand == "ORMA" %}<a href="{{ '/orma/' | lurl: lang }}" class="orma-mark orma-mark--small p-top__mark"><span class="orma-mark__word">{% include "svg/orma-wordmark.svg" %}</span><span class="orma-mark__by">{{ t.product.orma_by }}</span></a>{% endif %}
    <h1 class="h1">{{ title }}</h1>
    <p class="sec__text">{{ summary_ }}</p>
    <div class="buy p-top__buy" id="buy" aria-label="{{ t.a11y.purchase }}">
      {% include "partials/buy.liquid" %}
    </div>
  </div></div>
</section>

{% if dims_ %}
<section class="sec sec--grey">
  <div class="wrap">
    <dl class="figs">
      {% for d in dims_ %}<div class="fig"><dt class="fig__label">{{ d[1] }}</dt><dd class="fig__value">{{ d[0] }}</dd></div>{% endfor %}
    </dl>
  </div>
</section>
{% endif %}
{% endif %}

{% if body_ != blank and storyImage %}
<section class="duo">
  <div class="duo__text"><div class="duo__inner">
    <h2 class="h2">{{ storyTitle_ }}</h2>
    <div class="prose mt-4">{{ body_ }}</div>
  </div></div>
  <div class="duo__media"><img src="{{ storyImage | replace: '-1000', '-2000' }}" alt="{{ storyAlt_ }}" loading="lazy"{% if storyPos %} style="object-position: {{ storyPos }}"{% endif %}></div>
</section>
{% endif %}

{% if type == "bike" and status != "announced" %}
<section class="section" id="colours">
  <div class="wrap">
    <h2 class="h2 block-title">{{ t.product.colours_title }}</h2>
    <div class="picker" data-picker>
      <div class="picker__stage">
        {% for f in finishes %}
        <div class="picker__view{% if forloop.first %} is-active{% endif %}" data-finish="{{ f.name | slugify }}">
          {% assign fimg = f.frameImage | default: f.bikeImage | default: f.image %}{% if fimg %}<img src="{{ fimg | replace: '-1000', '-2000' }}" alt="{{ t.product.frame_in | fill: 'name', f.name }}" loading="lazy">{% else %}<div class="picker__flat" style="background: {{ f.hex }}"></div>{% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="picker__controls" role="radiogroup" aria-label="{{ t.product.finish }}">
        {% for f in finishes %}{% assign surface = t.surface_caption[f.surface] | default: f.surface %}<button type="button" class="picker__chip" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" data-finish="{{ f.name | slugify }}" data-caption="{{ f.name }}, {{ surface }}"><i style="background: {{ f.hex }}"></i><span>{{ f.name }}</span></button>{% endfor %}
      </div>
      {% assign f0 = finishes | first %}{% assign surface0 = t.surface_caption[f0.surface] | default: f0.surface %}<p class="picker__caption micro" aria-live="polite">{{ f0.name }}, {{ surface0 }}</p>
    </div>
  </div>
{% if closeups %}
  <div class="strip strip--in">
    <div class="strip__track" data-strip tabindex="0">{% for c in closeups %}<img src="{{ c[0] }}" alt="{{ L.closeupAlts[forloop.index0] | default: c[1] }}" loading="lazy">{% endfor %}</div>
    <div class="wrap strip__nav"><button type="button" class="strip__btn" data-strip-prev aria-label="{{ t.a11y.prev }}">←</button><button type="button" class="strip__btn" data-strip-next aria-label="{{ t.a11y.next }}">→</button></div>
  </div>
{% endif %}
</section>
{% if momentImage %}
<figure class="bleed"><img src="{{ momentImage }}" alt="{{ L.momentAlt | default: momentAlt }}" loading="lazy"></figure>
{% endif %}

{% if ride_ %}
<section class="section" id="details">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2">{{ ride_.title }}</h2>
      <p class="lead">{{ ride_.intro }}</p>
    </div>
    <ol class="steps steps--ride">
      {% for r in ride_.items %}<li class="step"><h3 class="h3">{{ r[0] }}</h3><p>{{ r[1] }}</p></li>
      {% endfor %}
    </ol>
  </div>
</section>
{% elsif features_ %}
<section class="section" id="details">
  <div class="wrap">
    <h2 class="h2 block-title">{{ L.featuresTitle | default: featuresTitle | default: t.product.look_closer }}</h2>
    <div class="features">
      {% for f in features_ %}
      <article class="feature">
        {% include "partials/frame.liquid", img: f.image, ratio: "bike", contain: f.contain, pos: f.pos, alt: f.alt %}
        <details class="feature__more">
          <summary>{{ f.title }}</summary>
          <p>{{ f.text }}</p>
          {% if f.link %}<a class="linkline" href="{{ f.link | lurl: lang }}">{{ f.linkText }}</a>{% endif %}
        </details>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% else %}
<section class="section">
  <div class="wrap">
    <div class="specced">
      {% include "partials/frame.liquid", img: "/assets/img/web/orma-momentum-pair-1000.jpg", ratio: "bike", contain: true, alt: "ORMA Momentum" %}
      <div>
        <p class="orma-mark orma-mark--small"><span class="orma-mark__word">{% include "svg/orma-wordmark.svg" %}</span><span class="orma-mark__by">{{ t.product.orma_by }}</span></p>
        {% if platform == "gravel" %}
        <h3 class="h3 mt-3">{{ t.product.specced_gravel_title }}</h3>
        <p class="small mt-2">{{ t.product.specced_gravel_text | fill: "title", title }}</p>
        {% else %}
        <h3 class="h3 mt-3">{{ t.product.specced_title }}</h3>
        <p class="small mt-2">{{ t.product.specced_text | fill: "title", title }}</p>
        {% endif %}
        <a class="linkline mt-3" href="{{ '/wheelsets/orma-momentum/' | lurl: lang }}">{{ t.product.see_wheelset }}</a>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if configureUrl and type == "bike" %}
<section class="section" id="builds">
  <div class="wrap">
    <h2 class="h2 block-title">{{ t.product.builds_title }}</h2>
    <div class="trio">
      {% for g in configurator.vent.groupsets %}
      {% assign gp = g.price | minus: configurator.vent.earlyBird.discount %}<div class="tile tile--text"><p class="tile__name">{{ g.label }}</p><p class="tile__note">CHF {{ gp | chf }}{% if g.powermeter %}<br>{{ t.product.with_pm | fill: "price", g.powermeter }}{% endif %}</p></div>
      {% endfor %}
    </div>
    <p class="block__text mt-4">{{ t.product.builds_text }}</p>
    <a class="linkline block-link" href="{{ configureHref }}">{{ t.buy.configure }}</a>
  </div>
</section>
{% endif %}

{%- comment -%} A bike with a teaser drawing shows its geometry there until the numbers are final. {%- endcomment -%}
{% unless sketch %}
<section class="section" id="geometry">
  <div class="wrap">
    <div class="section-head"><h2 class="h2">{{ t.product.geometry }}</h2><p class="lead">{{ geometrySource_ | default: t.product.geometry_pending }}</p></div>
    {% if geometryImage %}<img class="geometry-drawing" src="{{ geometryImage }}" alt="{{ t.product.geometry }} {{ title }}" loading="lazy">{% endif %}
    {% if geometryRows %}
    <div class="geo-pick" data-geo>
      <div class="geo-pick__sizes" role="radiogroup" aria-label="{{ t.product.size }}">
        {% for s in sizes %}<button type="button" class="geo-chip" role="radio" data-size="{{ forloop.index }}" aria-checked="{% if s == 'M' %}true{% else %}false{% endif %}">{{ s }}</button>{% endfor %}
      </div>
      <dl class="geo-pick__list">
        {% for row in geometryRows %}{% assign gi = forloop.index %}<div class="geo-pick__row"><dt>{% if geometryNumbered %}<span class="geo-no">{{ gi }}</span>{% endif %}{{ t.geo[row[0]] | default: row[0] }}</dt>{% for c in row %}{% unless forloop.first %}{% assign si = forloop.index0 | minus: 1 %}<dd data-size="{{ forloop.index0 }}"{% unless sizes[si] == "M" %} hidden{% endunless %}>{{ c }}{% unless c contains "°" %} mm{% endunless %}</dd>{% endunless %}{% endfor %}</div>
        {% endfor %}
      </dl>
    </div>
    {% endif %}
    <div class="scroll-x"{% if geometryRows %} hidden{% endif %}>
      <table class="table table--wide">
        <thead><tr><th>{{ t.product.size }}</th>{% for s in sizes %}<th>{{ s }}</th>{% endfor %}</tr></thead>
        <tbody>
        {% if geometryRows %}
          {% for row in geometryRows %}{% assign gi = forloop.index %}<tr>{% for c in row %}{% if forloop.first %}<th>{% if geometryNumbered %}<span class="geo-no">{{ gi }}</span>{% endif %}{{ t.geo[c] | default: c }}</th>{% else %}<td>{{ c }}</td>{% endif %}{% endfor %}</tr>{% endfor %}
        {% else %}
          {% for row in geometry %}<tr><th>{{ t.geo[row] | default: row }}</th>{% for s in sizes %}<td class="no">–</td>{% endfor %}</tr>{% endfor %}
        {% endif %}
        </tbody>
      </table>
    </div>
    {% if sizeChart %}
    <div class="sizechart">
      <h3 class="h3">{{ t.product.sizechart_title }}</h3>
      <p class="small">{{ t.product.sizechart_text }}</p>
      <div class="sizechart__rows" style="--from: 150; --to: 200">
        {% for r in sizeChart %}<div class="sizechart__row"><span class="sizechart__size">{{ r[0] }}<span class="sizechart__range"> {{ r[1] }}–{{ r[2] }}</span></span><span class="sizechart__track"><span class="sizechart__bar" style="--a: {{ r[1] }}; --b: {{ r[2] }}"><span class="sizechart__label">{{ r[1] }}–{{ r[2] }} cm</span></span></span></div>
        {% endfor %}
        <div class="sizechart__row sizechart__row--scale"><span class="sizechart__size"></span><span class="sizechart__track">{% for x in (150..200) %}{% assign m = x | modulo: 10 %}{% if m == 0 %}<span class="sizechart__tick" style="--x: {{ x }}">{{ x }}</span>{% endif %}{% endfor %}</span></div>
      </div>
    </div>
    {% endif %}
  </div>
</section>
{% endunless %}

{% endif %}

{%- comment -%} Closing sections alternate grey and white. {%- endcomment -%}
{% if specs_ %}
<section class="sec sec--grey" id="specs">
  <div class="wrap g">
    <div class="tab-a">
      <h2 class="h2">{{ specsTitle_ }}</h2>
      {% if specsNote_ %}<p class="sec__text">{{ specsNote_ }}</p>{% endif %}
    </div>
    <div class="tab-b tab-b--wide">
      <table class="table table--v4">
        <tbody>{% for s in specs_ %}<tr><th>{{ s[0] }}</th><td>{{ s[1] }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
  </div>
</section>
{% endif %}

{% if compat_ %}
<section class="sec" id="compatibility">
  <div class="wrap g">
    <div class="tab-a">
      <h2 class="h2">{{ t.product.compat_title }}</h2>
      <p class="sec__text">{{ t.product.compat_lead }}</p>
      {% if type == "wheelset" %}<a class="linkline" href="{{ '/bikes/' | lurl: lang }}">{{ t.product.see_bikes }}</a>{% endif %}
    </div>
    <div class="tab-b tab-b--wide">
      <table class="table table--v4 table--compat">
        <thead><tr>{% for h in t.product.compat_head %}<th>{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>{% for c in compat_ %}<tr><th>{{ c[0] }}</th><td class="{{ c[1] }}">{{ t.product.compat_values[c[1]] | default: c[1] }}</td><td>{{ c[2] }}</td></tr>{% endfor %}</tbody>
      </table>
      {% if type == "wheelset" %}<p class="small mt-3">{{ t.product.wheelset_note }}</p>{% endif %}
    </div>
  </div>
</section>
{% endif %}

{% if faq_ %}
{%- assign faqTone = " sec--grey" -%}{%- if specs_ -%}{%- unless compat_ -%}{%- assign faqTone = "" -%}{%- endunless -%}{%- endif -%}
<section class="sec{{ faqTone }}" id="faq">
  <div class="wrap g">
    <div class="tab-a">
      <h2 class="h2">{{ t.product.faq_title }}</h2>
      <a class="linkline" href="{{ '/service/' | lurl: lang }}#contact">{{ t.product.write_to_us }}</a>
    </div>
    <div class="tab-b tab-b--wide">
      <div class="faq faq--v4">
        {% for q in faq_ %}<details><summary>{{ q[0] }}</summary><p>{{ q[1] }}</p></details>{% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if type == "bike" %}
{%- assign family = collections.products | in_category: category, lang -%}
{%- assign wheelsets = collections.products | in_category: "wheelsets", lang -%}
{% comment %} "More from SENDA" removed in review MG 1; restore from git if wanted. {% endcomment %}
{% endif %}
