---
layout: layouts/base.liquid
---
{%- assign items = collections.products | in_category: category -%}
<div class="wrap">
  <header class="page-head">
    <h1 class="h1">{{ title }}</h1>
    <p class="lead">{{ intro }}</p>
  </header>

  {% if orma %}
  <p class="orma-intro orma-mark"><span class="orma-mark__word">ORMA</span><span class="orma-mark__by">Wheels and components by SENDA. <a href="/orma/" style="text-decoration:underline">The ORMA story</a></span></p>
  {% endif %}

  {% if items.size > 0 %}
  <div class="trio" style="grid-template-columns: repeat({{ cols | default: 3 }}, minmax(0, 1fr)); padding-bottom: var(--section)">
    {% for p in items %}
      {% if expandColours and p.data.colours %}
        {% for c in p.data.colours %}
        <a class="tile" href="{{ p.url }}">
          {% include "partials/frame.liquid", img: c.image, ratio: "bike", contain: true, alt: c.alt %}
          <span class="tile__name">{{ c.name }}</span>
          <span class="tile__note">{{ p.data.title }}</span>
        </a>
        {% endfor %}
      {% else %}{% include "partials/card.liquid", p: p, cardRatio: cardRatio %}{% endif %}
    {% endfor %}
  </div>
  {% else %}
  <section class="coming" style="margin-bottom: var(--section)">
    <div>
      <h2 class="h2">{{ comingTitle }}</h2>
      <p class="lead mt-3">{{ comingText }}</p>
    </div>
    <form class="js-signup" data-list="{{ list | default: 'senda' }}" novalidate>
      <div class="signup__form">
        <label class="visually-hidden" for="coming-email">Email address</label>
        <input class="field" id="coming-email" name="email" type="email" placeholder="Your email address" autocomplete="email">
        <button type="submit">Notify me</button>
      </div>
      <label class="consent mt-2"><input type="checkbox" name="consent"> I agree to receive emails about ORMA and SENDA news.</label>
      <p class="form-msg mt-2" role="status" aria-live="polite"></p>
    </form>
  </section>
  {% endif %}
</div>
