{%- assign title_ = C.title | default: L.title | default: title -%}
{%- assign description_ = C.description | default: L.description | default: description | default: t.meta.description -%}
{%- assign other_ = page.url | alt_url: lang, collections.all -%}
<!doctype html>
<html lang="{{ lang | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title_ and page.url != "/" and page.url != "/de/" %}{{ title_ }} | SENDA{% else %}{{ t.meta.title_home }}{% endif %}</title>
  <meta name="description" content="{{ description_ }}">
  <link rel="alternate" hreflang="{{ lang | default: 'en' }}" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ t.other.code }}" href="{{ site.url }}{{ other_ }}">
  {% unless env.production %}<meta name="robots" content="noindex, nofollow">{% endunless %}
  <meta property="og:title" content="{{ title_ | default: 'SENDA' }}">
  <meta property="og:description" content="{{ description_ }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/web/lake-road-2000.jpg">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles/tokens.css">
  <link rel="stylesheet" href="/styles/site.css">
  <script src="/assets/js/cookie-consent.js" defer></script>
  <script src="/scripts/site.js" defer></script>
</head>
<body>
  <a class="visually-hidden" href="#main">{{ t.a11y.skip }}</a>
  {% if published == false %}<div class="draft-banner">Preview only: this page is not part of the launch scope</div>{% endif %}
  {% include "partials/header.liquid" %}
  <main id="main"{% if status %} data-product data-state="{{ status }}"{% endif %}>
    {{ content }}
  </main>
  {% include "partials/footer.liquid" %}
  {% if status %}{% unless env.production %}
  <div class="review-bar" role="group" aria-label="Preview product state">
    <span>State</span>
    <button type="button" data-set-state="announced">Announced</button>
    <button type="button" data-set-state="preorder">Pre-order</button>
    <button type="button" data-set-state="available">Available</button>
  </div>
  {% endunless %}{% endif %}
  <script>window.SENDA = { lang: "{{ lang | default: 'en' }}", subscribeUrl: "{{ site.subscribeUrl }}", t: {{ t.js | json }} };</script>
</body>
</html>
